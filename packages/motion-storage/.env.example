# Copy to .env in this package (or export in the shell) before:
#   pnpm --filter @motionvideo/motion-storage start

# Listen port (PORT wins if both are set)
PORT=8787
# MOTION_STORAGE_PORT=8787

# Public base URL used in upload/download links returned to clients
MOTION_STORAGE_PUBLIC_URL=http://127.0.0.1:8787

# Object backend: memory (local/CI) | r2 (Cloudflare R2)
MOTION_STORAGE_PROVIDER=memory

# Optional. If set, every request needs: Authorization: Bearer <token>
# MOTION_STORAGE_API_TOKEN=

# Required when MOTION_STORAGE_PROVIDER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Optional custom S3-compatible endpoint (defaults to https://<account>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
