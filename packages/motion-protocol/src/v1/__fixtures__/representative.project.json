{
  "format": "motion-project",
  "formatVersion": 1,
  "metadata": {
    "id": "v1-representative",
    "name": "V1 Representative",
    "description": "Root layers (text, audio), variables, bindings, and tokens",
    "locale": "vi-VN",
    "tags": [
      "demo",
      "v1"
    ]
  },
  "composition": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "background": "#ffffff",
    "colorSpace": "srgb",
    "audioSampleRate": 48000,
    "motionBlur": {
      "samples": 8,
      "shutterAngle": 180,
      "shutterPhase": 0
    }
  },
  "capabilities": {
    "required": [
      "primitive.group",
      "primitive.text",
      "primitive.image"
    ],
    "optional": [
      "effect.blur"
    ]
  },
  "dependencies": {
    "compiler": {
      "range": ">=1.0.0"
    },
    "components": [
      {
        "componentId": "logo-reveal",
        "version": "1.0.0",
        "integrity": "sha256:logo-reveal-1.0.0"
      }
    ]
  },
  "tokens": {
    "colors": {
      "brand": "#1877f2",
      "accent": "#ff5722"
    },
    "fonts": {
      "display": "font-inter"
    },
    "spacing": {
      "unit": 8
    }
  },
  "variables": [
    {
      "id": "founder-name",
      "name": "Founder name",
      "type": "string",
      "value": "Mark Zuckerberg"
    },
    {
      "id": "brand-color",
      "name": "Brand color",
      "type": "color",
      "value": "#1877f2"
    },
    {
      "id": "title-opacity",
      "name": "Title opacity",
      "type": "number",
      "value": 90,
      "min": 0,
      "max": 100
    },
    {
      "id": "show-subtitle",
      "name": "Show subtitle",
      "type": "boolean",
      "value": true
    }
  ],
  "assets": [
    {
      "id": "logo-png",
      "uri": "./assets/images/logo.png",
      "integrity": "sha256:logo-png",
      "assetType": "image",
      "mimeType": "image/png",
      "width": 512,
      "height": 512,
      "pixelFormat": "rgba",
      "hasAlpha": true
    },
    {
      "id": "bgm",
      "uri": "./assets/audio/bgm.mp3",
      "integrity": "sha256:bgm",
      "assetType": "audio",
      "mimeType": "audio/mpeg",
      "duration": 42.5,
      "codec": "mp3",
      "sampleRate": 48000,
      "channels": 2
    }
  ],
  "components": [
    {
      "id": "logo-reveal",
      "version": "1.0.0",
      "integrity": "sha256:logo-reveal-1.0.0",
      "props": [
        {
          "id": "logo-visible",
          "name": "Logo Visible",
          "kind": "boolean",
          "default": true
        },
        {
          "id": "logo-color",
          "name": "Logo Color",
          "kind": "color",
          "default": "#1877f2"
        }
      ],
      "propBindings": [
        {
          "propId": "logo-visible",
          "target": {
            "kind": "layerProperty",
            "layerId": "logo",
            "property": "appearance.visible"
          }
        },
        {
          "propId": "logo-color",
          "target": {
            "kind": "layerProperty",
            "layerId": "logo",
            "property": "payload.color"
          }
        }
      ],
      "variables": [],
      "layers": [
        {
          "id": "logo",
          "type": "solid",
          "parentLayerId": null,
          "transform": {
            "translate": {
              "x": 0,
              "y": 0
            },
            "rotate": {
              "z": 0
            },
            "scale": {
              "x": 1,
              "y": 1
            },
            "skew": {
              "x": 0,
              "y": 0
            },
            "origin": {
              "x": 0.5,
              "y": 0.5
            }
          },
          "payload": {
            "color": "#1877f2"
          },
          "frame": {
            "width": 256,
            "height": 256
          },
          "appearance": {
            "visible": true,
            "opacity": 100
          }
        }
      ]
    }
  ],
  "timeline": {
    "duration": 8,
    "workArea": {
      "start": 0,
      "end": 8
    }
  },
  "bindings": [
    {
      "id": "binding-founder-name",
      "source": {
        "kind": "variable",
        "variableId": "founder-name"
      },
      "target": {
        "type": "layer",
        "layerId": "subtitle",
        "property": "payload.content.text"
      }
    },
    {
      "id": "binding-title-opacity",
      "source": {
        "kind": "variable",
        "variableId": "title-opacity"
      },
      "target": {
        "type": "layer",
        "layerId": "title",
        "property": "appearance.opacity"
      }
    }
  ],
  "layers": [
    {
      "id": "title",
      "type": "text",
      "parentLayerId": null,
      "transform": {
        "translate": {
          "x": 0,
          "y": -200
        },
        "rotate": {
          "z": 0
        },
        "scale": {
          "x": 1,
          "y": 1
        },
        "skew": {
          "x": 0,
          "y": 0
        },
        "origin": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "payload": {
        "content": {
          "kind": "plain",
          "text": "Hello MotiClip"
        },
        "fontSize": 64,
        "color": "#111111",
        "alignment": "center"
      },
      "zIndex": 0,
      "timing": {
        "start": 0,
        "duration": 5
      },
      "frame": {
        "width": 800,
        "height": 120
      },
      "appearance": {
        "visible": true,
        "opacity": 100
      }
    },
    {
      "id": "subtitle",
      "type": "text",
      "parentLayerId": null,
      "transform": {
        "translate": {
          "x": 0,
          "y": 200
        },
        "rotate": {
          "z": 0
        },
        "scale": {
          "x": 1,
          "y": 1
        },
        "skew": {
          "x": 0,
          "y": 0
        },
        "origin": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "payload": {
        "content": {
          "kind": "plain",
          "text": "Powered by V1"
        },
        "fontSize": 40,
        "color": "#555555",
        "alignment": "center"
      },
      "zIndex": 1,
      "timing": {
        "start": 0,
        "duration": 5
      },
      "frame": {
        "width": 700,
        "height": 80
      },
      "appearance": {
        "visible": true,
        "opacity": 100
      }
    },
    {
      "id": "logo-img",
      "type": "image",
      "parentLayerId": null,
      "transform": {
        "translate": {
          "x": 0,
          "y": -80
        },
        "rotate": {
          "z": 0
        },
        "scale": {
          "x": 1,
          "y": 1
        },
        "skew": {
          "x": 0,
          "y": 0
        },
        "origin": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "payload": {
        "assetId": "logo-png",
        "fit": "contain"
      },
      "zIndex": 2,
      "timing": {
        "start": 0,
        "duration": 5
      },
      "frame": {
        "width": 200,
        "height": 200
      },
      "appearance": {
        "visible": true,
        "opacity": 90
      }
    },
    {
      "id": "cam",
      "type": "camera",
      "parentLayerId": null,
      "transform": {
        "translate": {
          "x": 0,
          "y": 0
        },
        "rotate": {
          "z": 0
        },
        "scale": {
          "x": 1,
          "y": 1
        },
        "skew": {
          "x": 0,
          "y": 0
        },
        "origin": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "payload": {
        "projection": "orthographic",
        "zoom": 1
      },
      "zIndex": 3,
      "timing": {
        "start": 0,
        "duration": 5
      },
      "appearance": {
        "visible": true,
        "opacity": 100
      }
    },
    {
      "id": "thanks",
      "type": "text",
      "parentLayerId": null,
      "transform": {
        "translate": {
          "x": 0,
          "y": 0
        },
        "rotate": {
          "z": 0
        },
        "scale": {
          "x": 1,
          "y": 1
        },
        "skew": {
          "x": 0,
          "y": 0
        },
        "origin": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "payload": {
        "content": {
          "kind": "plain",
          "text": "Thanks for watching"
        },
        "fontSize": 48,
        "color": "#111111",
        "alignment": "center"
      },
      "zIndex": 4,
      "timing": {
        "start": 0,
        "duration": 3
      },
      "frame": {
        "width": 700,
        "height": 100
      },
      "appearance": {
        "visible": true,
        "opacity": 100
      }
    },
    {
