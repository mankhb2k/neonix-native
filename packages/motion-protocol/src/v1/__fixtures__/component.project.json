{
  "format": "motion-project",
  "formatVersion": 1,
  "metadata": {
    "id": "v1-component",
    "name": "V1 Component Example",
    "description": "Demonstrates embedded component definition and root component layer instances",
    "locale": "vi-VN",
    "tags": [
      "example",
      "v1",
      "component"
    ]
  },
  "composition": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "background": "#ffffff",
    "colorSpace": "srgb",
    "audioSampleRate": 48000
  },
  "capabilities": {
    "required": [
      "primitive.text",
      "primitive.solid",
      "component.embedding"
    ]
  },
  "dependencies": {
    "compiler": {
      "range": ">=1.0.0"
    },
    "components": [
      {
        "componentId": "call-to-action",
        "version": "1.0.0",
        "source": "com.moticlip.store",
        "integrity": "sha256:cta-1.0.0"
      }
    ]
  },
  "tokens": {},
  "variables": [
    {
      "id": "cta-text",
      "name": "CTA Button Text",
      "type": "string",
      "value": "Tìm hiểu thêm"
    }
  ],
  "assets": [],
  "components": [
    {
      "id": "call-to-action",
      "version": "1.0.0",
      "integrity": "sha256:cta-1.0.0",
      "props": [
        {
          "id": "label",
          "name": "Button label",
          "kind": "text",
          "default": "Click me"
        },
        {
          "id": "color",
          "name": "Button color",
          "kind": "color",
          "default": "#1877f2"
        }
      ],
      "variants": [
        {
          "id": "primary",
          "name": "Primary CTA",
          "props": {
            "color": "#1877f2"
          }
        },
        {
          "id": "outline",
          "name": "Outline CTA",
          "props": {
            "color": "#ffffff"
          }
        }
      ],
      "propBindings": [
        {
          "propId": "label",
          "target": {
            "kind": "layerProperty",
            "layerId": "cta-label-node",
            "property": "payload.content.text"
          }
        },
        {
          "propId": "color",
          "target": {
            "kind": "layerProperty",
            "layerId": "cta-bg",
            "property": "payload.color"
          }
        }
      ],
      "variables": [
        {
          "id": "cta-label",
          "name": "CTA Label",
          "type": "string",
          "value": "Click me"
        },
        {
          "id": "cta-color",
          "name": "CTA Color",
          "type": "color",
          "value": "#1877f2"
        }
      ],
      "layers": [
        {
          "id": "cta-bg",
          "type": "solid",
          "parentLayerId": null,
          "zIndex": 0,
          "transform": {
            "translate": {
              "x": 0,
              "y": 0
            },
            "rotate": {
              "x": 0,
              "y": 0,
              "z": 0
            },
            "scale": {
              "x": 1,
              "y": 1,
              "z": 1
            },
            "skew": {
              "x": 0,
              "y": 0
            },
            "origin": {
              "x": 0.5,
              "y": 0.5,
              "z": 0
            },
            "transform-style": "flat",
            "backface-visibility": "visible"
          },
          "payload": {
            "color": "#1877f2"
          },
          "frame": {
            "width": 600,
            "height": 120
          },
          "appearance": {
            "visible": true,
            "opacity": 100
          }
        },
        {
          "id": "cta-label-node",
          "type": "text",
          "parentLayerId": null,
          "zIndex": 1,
          "transform": {
            "translate": {
              "x": 0,
              "y": 0
            },
            "rotate": {
              "x": 0,
              "y": 0,
              "z": 0
            },
            "scale": {
              "x": 1,
              "y": 1,
              "z": 1
            },
            "skew": {
              "x": 0,
              "y": 0
            },
            "origin": {
              "x": 0.5,
              "y": 0.5,
              "z": 0
            },
            "transform-style": "flat",
            "backface-visibility": "visible"
          },
          "payload": {
            "content": {
              "kind": "plain",
              "text": "Click me"
            },
            "fontSize": 40,
            "color": "#ffffff",
            "alignment": "center"
          },
          "frame": {
            "width": 500,
            "height": 60
          },
          "appearance": {
            "visible": true,
            "opacity": 100
          }
        }
      ]
    }
  ],
  "timeline": {},
  "bindings": [
    {
      "id": "bind-cta",
      "source": {
        "kind": "variable",
        "variableId": "cta-text"
      },
      "target": {
        "type": "componentLayer",
        "layerId": "cta-instance",
        "propId": "label"
      }
    }
  ],
  "layers": [
    {
      "id": "title",
      "type": "text",
      "parentLayerId": null,
      "transform": {
        "translate": {
          "x": 0,
          "y": -200
        },
        "rotate": {
          "x": 0,
          "y": 0,
          "z": 0
        },
        "scale": {
          "x": 1,
          "y": 1,
          "z": 1
        },
        "skew": {
          "x": 0,
          "y": 0
        },
        "origin": {
          "x": 0.5,
          "y": 0.5,
          "z": 0
        },
        "transform-style": "flat",
        "backface-visibility": "visible"
      },
      "payload": {
        "content": {
          "kind": "plain",
          "text": "Welcome to MotiClip"
        },
        "fontSize": 56,
        "color": "#111111",
        "alignment": "center"
      },
      "zIndex": 0,
      "timing": {
        "start": 0,
        "duration": 5
      },
      "frame": {
        "width": 800,
        "height": 120
      },
      "appearance": {
        "visible": true,
        "opacity": 100
      }
    },
    {
      "id": "cta-instance",
      "type": "component",
      "parentLayerId": null,
      "transform": {
        "translate": {
          "x": 100,
          "y": 200
        },
        "rotate": {
          "x": 0,
          "y": 0,
          "z": 0
        },
        "scale": {
          "x": 1,
          "y": 1,
          "z": 1
        },
        "skew": {
          "x": 0,
          "y": 0
        },
        "origin": {
          "x": 0.5,
          "y": 0.5,
          "z": 0
        },
        "transform-style": "flat",
        "backface-visibility": "visible"
      },
      "payload": {
        "componentId": "call-to-action"
      },
      "zIndex": 1,
      "timing": {
        "start": 0,
        "duration": 2.5
      },
      "frame": {
        "width": 600,
        "height": 120
      },
      "appearance": {
        "visible": true,
        "opacity": 100
      }
    }
  ]
}
