    {
      "id": "cta-instance",
      "type": "component",
      "parentLayerId": null,
      "transform": {
        "translate": {
          "x": 100,
          "y": 200
        },
        "rotate": {
          "z": 0
        },
        "scale": {
          "x": 1,
          "y": 1
        },
        "skew": {
          "x": 0,
          "y": 0
        },
        "origin": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "payload": {
        "componentId": "call-to-action"
      },
      "zIndex": 1,
      "timing": {
        "start": 0,
        "duration": 2.5
      },
      "frame": {
        "width": 600,
        "height": 120
      },
      "opacity": 100
    }
  ]
}
