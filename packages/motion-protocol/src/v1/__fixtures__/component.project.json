{
  "format": "motion-project",
  "formatVersion": 1,
  "metadata": {
    "id": "v1-component",
    "name": "V1 Component Example",
    "locale": "vi-VN"
  },
  "composition": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "background": "#ffffff",
    "colorSpace": "srgb",
    "audioSampleRate": 48000
  },
  "assets": [],
  "components": [
    {
      "id": "call-to-action",
      "version": "1.0.0",
      "integrity": "sha256:cta-1.0.0",
      "props": [
        {
          "id": "label",
          "name": "Button label",
          "kind": "string",
          "default": "Click me"
        },
        {
          "id": "color",
          "name": "Button color",
          "kind": "color",
          "default": "#1877f2"
        }
      ],
      "variants": [
        {
          "id": "primary",
          "name": "Primary CTA",
          "props": {
            "color": "#1877f2"
          }
        },
        {
          "id": "outline",
          "name": "Outline CTA",
          "props": {
            "color": "#ffffff"
          }
        }
      ],
      "propBindings": [
        {
          "propId": "label",
          "target": {
            "kind": "layerProperty",
            "layerId": "cta-label-node",
            "property": "payload.text"
          }
        },
        {
          "propId": "color",
          "target": {
            "kind": "layerProperty",
            "layerId": "cta-bg",
            "property": "payload.color"
          }
        }
      ],
      "layers": [
        {
          "id": "cta-bg",
          "type": "solid",
          "parentLayerId": null,
          "zIndex": 0,
          "timing": {
            "start": 0,
            "duration": 5
          },
          "transform": {
            "translate": {
              "x": 0,
              "y": 0
            },
            "rotate": {
              "z": 0
            },
            "scale": {
              "x": 1,
              "y": 1
            },
            "skew": {
              "x": 0,
              "y": 0
            },
            "origin": {
              "x": 0.5,
              "y": 0.5
            }
          },
          "payload": {
            "color": "#1877f2"
          },
          "frame": {
            "width": 600,
            "height": 120
          },
          "opacity": 100
        },
        {
          "id": "cta-label-node",
          "type": "text",
          "parentLayerId": null,
          "zIndex": 1,
          "transform": {
            "translate": {
              "x": 0,
              "y": 0
            },
            "rotate": {
              "z": 0
            },
            "scale": {
              "x": 1,
              "y": 1
            },
            "skew": {
              "x": 0,
              "y": 0
            },
            "origin": {
              "x": 0.5,
              "y": 0.5
            }
          },
          "payload": {
            "fontSize": 40,
            "color": "#ffffff",
            "alignment": "center",
            "text": "Click me"
          },
          "frame": {
            "width": 500,
            "height": 60
          },
          "timing": {
            "start": 0,
            "duration": 5
          },
          "opacity": 100
        }
      ]
    }
  ],
  "layers": [
    {
      "id": "title",
      "type": "text",
      "parentLayerId": null,
      "transform": {
        "translate": {
          "x": 0,
          "y": -200
        },
        "rotate": {
          "z": 0
        },
        "scale": {
          "x": 1,
          "y": 1
        },
        "skew": {
          "x": 0,
          "y": 0
        },
        "origin": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "payload": {
        "fontSize": 56,
        "color": "#111111",
        "alignment": "center",
        "text": "Welcome to MotiClip"
      },
      "zIndex": 0,
      "timing": {
        "start": 0,
        "duration": 5
      },
      "frame": {
        "width": 800,
        "height": 120
      },
      "opacity": 100
