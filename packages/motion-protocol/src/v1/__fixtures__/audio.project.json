{
  "format": "motion-project",
  "formatVersion": 1,
  "metadata": {
    "id": "v1-audio",
    "name": "V1 Audio Example",
    "description": "Demonstrates audio tracks (BGM + voiceover) on the timeline",
    "locale": "vi-VN",
    "tags": [
      "example",
      "v1",
      "audio"
    ]
  },
  "composition": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "background": "#000000",
    "colorSpace": "srgb",
    "audioSampleRate": 48000
  },
  "capabilities": {
    "required": [
      "primitive.text",
      "primitive.image",
      "audio.playback"
    ]
  },
  "dependencies": {
    "compiler": {
      "range": ">=1.0.0"
    },
    "components": []
  },
  "tokens": {},
  "variables": [],
  "assets": [
    {
      "id": "bgm-track",
      "uri": "./assets/audio/background.mp3",
      "integrity": "sha256:bgm",
      "assetType": "audio",
      "mimeType": "audio/mpeg",
      "duration": 30,
      "codec": "mp3",
      "sampleRate": 48000,
      "channels": 2
    },
    {
      "id": "voiceover",
      "uri": "./assets/audio/voiceover.mp3",
      "integrity": "sha256:voiceover",
      "assetType": "audio",
      "mimeType": "audio/mpeg",
      "duration": 10,
      "codec": "mp3",
      "sampleRate": 48000,
      "channels": 1
    },
    {
      "id": "sfx-whoosh",
      "uri": "./assets/audio/whoosh.mp3",
      "integrity": "sha256:sfx-whoosh",
      "assetType": "audio",
      "mimeType": "audio/mpeg",
      "duration": 1,
      "codec": "mp3",
      "sampleRate": 48000,
      "channels": 2
    }
  ],
  "components": [],
  "timeline": {},
  "bindings": [],
  "layers": [
    {
      "id": "opening-text",
      "type": "text",
      "parentLayerId": null,
      "transform": {
        "x": 0,
        "y": 0,
        "width": 800,
        "height": 100,
        "rotation": 0,
        "scaleX": 1,
        "scaleY": 1,
        "anchorX": 0.5,
        "anchorY": 0.5,
        "opacity": 1,
        "visible": true,
        "flipX": false,
        "flipY": false
      },
      "payload": {
        "content": {
          "kind": "plain",
          "text": "Opening Scene"
        },
        "fontSize": 56,
        "color": "#ffffff",
        "alignment": "center"
      },
      "zIndex": 0,
      "timing": {
        "start": 0,
        "duration": 5
      }
    },
    {
      "id": "content-text",
      "type": "text",
      "parentLayerId": null,
      "transform": {
        "x": 0,
        "y": 0,
        "width": 700,
        "height": 200,
        "rotation": 0,
        "scaleX": 1,
        "scaleY": 1,
        "anchorX": 0.5,
        "anchorY": 0.5,
        "opacity": 1,
        "visible": true,
        "flipX": false,
        "flipY": false
      },
      "payload": {
        "content": {
          "kind": "plain",
          "text": "Main Content with Voiceover"
        },
        "fontSize": 48,
        "color": "#ffffff",
        "alignment": "center"
      },
      "zIndex": 1,
      "timing": {
        "start": 0,
        "duration": 5
      }
    },
    {
      "id": "bgm-clip",
      "type": "audio",
      "parentLayerId": null,
      "zIndex": -1,
      "timing": {
        "start": 0,
        "duration": 10
      },
      "payload": {
        "assetId": "bgm-track",
        "volume": 0.3,
        "loop": false,
        "fadeIn": 1,
        "fadeOut": 1
      }
    },
    {
      "id": "vo-clip",
      "type": "audio",
      "parentLayerId": null,
      "zIndex": -2,
      "timing": {
        "start": 0.5,
        "duration": 9
      },
      "payload": {
        "assetId": "voiceover",
        "volume": 1,
        "loop": false
      }
    },
    {
      "id": "sfx-1-clip",
      "type": "audio",
      "parentLayerId": null,
      "zIndex": -3,
      "timing": {
        "start": 4.8,
        "duration": 1
      },
      "payload": {
        "assetId": "sfx-whoosh",
        "volume": 0.8,
        "loop": false
      }
    },
    {
      "id": "sfx-2-clip",
      "type": "audio",
      "parentLayerId": null,
      "zIndex": -4,
      "timing": {
        "start": 9.8,
        "duration": 1
      },
      "payload": {
        "assetId": "sfx-whoosh",
        "volume": 0.8,
        "loop": false
      }
    }
  ]
}
