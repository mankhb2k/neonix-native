{
  "format": "motion-project",
  "formatVersion": 1,
  "metadata": {
    "id": "v1-audio",
    "name": "V1 Audio Example",
    "locale": "vi-VN"
  },
  "composition": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "background": "#000000",
    "colorSpace": "srgb",
    "audioSampleRate": 48000
  },
  "assets": [
    {
      "id": "bgm-track",
      "uri": "./assets/audio/background.mp3",
      "integrity": "sha256:bgm",
      "assetType": "audio",
      "mimeType": "audio/mpeg",
      "duration": 30,
      "codec": "mp3",
      "sampleRate": 48000,
      "channels": 2
    },
    {
      "id": "voiceover",
      "uri": "./assets/audio/voiceover.mp3",
      "integrity": "sha256:voiceover",
      "assetType": "audio",
      "mimeType": "audio/mpeg",
      "duration": 10,
      "codec": "mp3",
      "sampleRate": 48000,
      "channels": 1
    },
    {
      "id": "sfx-whoosh",
      "uri": "./assets/audio/whoosh.mp3",
      "integrity": "sha256:sfx-whoosh",
      "assetType": "audio",
      "mimeType": "audio/mpeg",
      "duration": 1,
      "codec": "mp3",
      "sampleRate": 48000,
      "channels": 2
    }
  ],
  "components": [],
  "layers": [
    {
      "id": "opening-text",
      "type": "text",
      "parentLayerId": null,
      "transform": {
        "translate": {
          "x": 0,
          "y": 0
        },
        "rotate": {
          "z": 0
        },
        "scale": {
          "x": 1,
          "y": 1
        },
        "skew": {
          "x": 0,
          "y": 0
        },
        "origin": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "payload": {
        "fontSize": 56,
        "color": "#ffffff",
        "alignment": "center",
        "text": "Opening Scene"
      },
      "zIndex": 0,
      "timing": {
        "start": 0,
        "duration": 5
      },
      "frame": {
        "width": 800,
        "height": 100
      },
      "opacity": 100
    },
    {
      "id": "content-text",
      "type": "text",
      "parentLayerId": null,
      "transform": {
        "translate": {
          "x": 0,
          "y": 0
        },
        "rotate": {
          "z": 0
        },
        "scale": {
          "x": 1,
          "y": 1
        },
        "skew": {
          "x": 0,
          "y": 0
        },
        "origin": {
          "x": 0.5,
          "y": 0.5
        }
      },
      "payload": {
        "fontSize": 48,
        "color": "#ffffff",
        "alignment": "center",
        "text": "Main Content with Voiceover"
      },
      "zIndex": 1,
      "timing": {
        "start": 0,
        "duration": 5
      },
      "frame": {
        "width": 700,
        "height": 200
      },
      "opacity": 100
    },
    {
      "id": "bgm-clip",
      "type": "audio",
      "parentLayerId": null,
      "zIndex": -1,
      "timing": {
        "start": 0,
        "duration": 10
      },
      "payload": {
        "assetId": "bgm-track",
        "volume": 30,
        "loop": false,
        "fadeIn": 1,
        "fadeOut": 1
      }
    },
    {
      "id": "vo-clip",
      "type": "audio",
      "parentLayerId": null,
      "zIndex": -2,
      "timing": {
        "start": 0.5,
        "duration": 9
      },
      "payload": {
        "assetId": "voiceover",
        "volume": 100,
        "loop": false
      }
    },
    {
      "id": "sfx-1-clip",
      "type": "audio",
      "parentLayerId": null,
      "zIndex": -3,
      "timing": {
        "start": 4.8,
        "duration": 1
      },
      "payload": {
        "assetId": "sfx-whoosh",
        "volume": 80,
        "loop": false
      }
    },
    {
      "id": "sfx-2-clip",
      "type": "audio",
      "parentLayerId": null,
      "zIndex": -4,
      "timing": {
        "start": 9.8,
        "duration": 1
      },
      "payload": {
        "assetId": "sfx-whoosh",
        "volume": 80,
        "loop": false
      }
    }
  ]
}
