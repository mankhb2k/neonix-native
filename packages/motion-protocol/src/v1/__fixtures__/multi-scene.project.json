{
  "format": "motion-project",
  "formatVersion": 1,
  "metadata": {
    "id": "v1-multi-layer",
    "name": "V1 Multi-Layer Example",
    "description": "Demonstrates multiple root layers on the layer stack with staggered timing and zIndex order",
    "locale": "vi-VN",
    "tags": [
      "example",
      "v1",
      "root-layers",
      "layer-stack"
    ]
  },
  "composition": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "background": "#f5f5f5",
    "colorSpace": "srgb",
    "audioSampleRate": 48000
  },
  "capabilities": {
    "required": [
      "primitive.text",
      "primitive.image"
    ]
  },
  "dependencies": {
    "compiler": {
      "range": ">=1.0.0"
    },
    "components": []
  },
  "tokens": {
    "colors": {
      "primary": "#1877f2",
      "text": "#111111"
    }
  },
  "variables": [
    {
      "id": "headline-text",
      "name": "Headline",
      "type": "string",
      "value": "Welcome to V1"
    }
  ],
  "assets": [
    {
      "id": "logo",
      "uri": "./assets/logo.png",
      "integrity": "sha256:logo",
      "assetType": "image",
      "mimeType": "image/png",
      "width": 512,
      "height": 512,
      "pixelFormat": "rgba",
      "hasAlpha": true
    }
  ],
  "components": [],
  "timeline": {},
  "bindings": [
    {
      "id": "bind-headline",
      "source": {
        "kind": "variable",
        "variableId": "headline-text"
      },
      "target": {
        "type": "layer",
        "layerId": "headline",
        "property": "payload.content.text"
      }
    }
  ],
  "layers": [
    {
      "id": "headline",
      "type": "text",
      "parentLayerId": null,
      "transform": {
        "translate": {
          "x": 0,
          "y": -300
        },
        "rotate": {
          "x": 0,
          "y": 0,
          "z": 0
        },
        "scale": {
          "x": 1,
          "y": 1,
          "z": 1
        },
        "skew": {
          "x": 0,
          "y": 0
        },
        "origin": {
          "x": 0.5,
          "y": 0.5,
          "z": 0
        },
        "transform-style": "flat",
        "backface-visibility": "visible"
      },
      "payload": {
        "content": {
          "kind": "plain",
          "text": "Welcome"
        },
        "fontSize": 64,
        "color": "#111111",
        "alignment": "center"
      },
      "zIndex": 0,
      "timing": {
        "start": 0,
        "duration": 3
      },
      "frame": {
        "width": 800,
        "height": 100
      },
      "appearance": {
        "visible": true,
        "opacity": 100
      }
    },
    {
      "id": "body-text",
      "type": "text",
      "parentLayerId": null,
      "transform": {
        "translate": {
          "x": 0,
          "y": 0
        },
        "rotate": {
          "x": 0,
          "y": 0,
          "z": 0
        },
        "scale": {
          "x": 1,
          "y": 1,
          "z": 1
        },
        "skew": {
          "x": 0,
          "y": 0
        },
        "origin": {
          "x": 0.5,
          "y": 0.5,
          "z": 0
        },
        "transform-style": "flat",
        "backface-visibility": "visible"
      },
      "payload": {
        "content": {
          "kind": "plain",
          "text": "This is body content"
        },
        "fontSize": 48,
        "color": "#333333",
        "alignment": "center"
      },
      "zIndex": 1,
      "timing": {
        "start": 0,
        "duration": 5
      },
      "frame": {
        "width": 700,
        "height": 200
      },
      "appearance": {
        "visible": true,
        "opacity": 100
      }
    },
    {
      "id": "thanks",
      "type": "text",
      "parentLayerId": null,
      "transform": {
        "translate": {
          "x": 0,
          "y": 0
        },
        "rotate": {
          "x": 0,
          "y": 0,
          "z": 0
        },
        "scale": {
          "x": 1,
          "y": 1,
          "z": 1
        },
        "skew": {
          "x": 0,
          "y": 0
        },
        "origin": {
          "x": 0.5,
          "y": 0.5,
          "z": 0
        },
        "transform-style": "flat",
        "backface-visibility": "visible"
      },
      "payload": {
        "content": {
          "kind": "plain",
          "text": "Thank you!"
        },
        "fontSize": 56,
        "color": "#1877f2",
        "alignment": "center"
      },
      "zIndex": 2,
      "timing": {
        "start": 0,
        "duration": 2
      },
      "frame": {
        "width": 600,
        "height": 80
      },
      "appearance": {
        "visible": true,
        "opacity": 100
      }
    }
  ]
}
