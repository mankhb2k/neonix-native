{
  "format": "motion-project",
  "formatVersion": 3,
  "metadata": {
    "id": "v3-representative",
    "name": "V3 Representative",
    "description": "Covers scene, visual track, audio, captions, tokens, variables",
    "locale": "vi-VN",
    "tags": [
      "demo",
      "v3"
    ]
  },
  "composition": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "background": "#ffffff",
    "colorSpace": "srgb",
    "audioSampleRate": 48000,
    "safeArea": {
      "top": 0.1,
      "right": 0.05,
      "bottom": 0.15,
      "left": 0.05
    },
    "motionBlur": {
      "samples": 8,
      "shutterAngle": 180,
      "shutterPhase": 0
    }
  },
  "capabilities": {
    "required": [
      "primitive.group",
      "primitive.text",
      "primitive.image"
    ],
    "optional": [
      "effect.blur"
    ]
  },
  "dependencies": {
    "compiler": {
      "range": ">=1.0.0"
    },
    "components": [
      {
        "componentId": "logo-reveal",
        "version": "1.0.0",
        "integrity": "sha256:logo-reveal-1.0.0"
      }
    ]
  },
  "tokens": {
    "colors": {
      "brand": "#1877f2",
      "accent": "#ff5722"
    },
    "fonts": {
      "display": "font-inter"
    },
    "spacing": {
      "unit": 8
    }
  },
  "variables": [
    {
      "id": "founder-name",
      "name": "Founder name",
      "type": "string",
      "value": "Mark Zuckerberg"
    },
    {
      "id": "brand-color",
      "name": "Brand color",
      "type": "color",
      "value": "#1877f2"
    },
    {
      "id": "title-opacity",
      "name": "Title opacity",
      "type": "number",
      "value": 0.9,
      "min": 0,
      "max": 1
    },
    {
      "id": "show-subtitle",
      "name": "Show subtitle",
      "type": "boolean",
      "value": true
    }
  ],
  "assets": [
    {
      "id": "logo-png",
      "uri": "./assets/images/logo.png",
      "integrity": "sha256:logo-png",
      "assetType": "image",
      "mimeType": "image/png",
      "width": 512,
      "height": 512,
      "pixelFormat": "rgba",
      "hasAlpha": true
    },
    {
      "id": "bgm",
      "uri": "./assets/audio/bgm.mp3",
      "integrity": "sha256:bgm",
      "assetType": "audio",
      "mimeType": "audio/mpeg",
      "duration": 42.5,
      "codec": "mp3",
      "sampleRate": 48000,
      "channels": 2
    }
  ],
  "components": [
    {
      "id": "logo-reveal",
      "version": "1.0.0",
      "integrity": "sha256:logo-reveal-1.0.0",
      "props": [
        {
          "id": "logo-visible",
          "name": "Logo Visible",
          "kind": "boolean",
          "default": true
        },
        {
          "id": "logo-color",
          "name": "Logo Color",
          "kind": "color",
          "default": "#1877f2"
        }
      ],
      "propBindings": [
        {
          "propId": "logo-visible",
          "target": {
            "kind": "layerProperty",
            "layerId": "logo",
            "property": "transform.visible"
          }
        },
        {
          "propId": "logo-color",
          "target": {
            "kind": "layerProperty",
            "layerId": "logo",
            "property": "payload.color"
          }
        }
      ],
      "variables": [],
      "layers": [
        {
          "id": "logo",
          "type": "solid",
          "parentLayerId": null,
          "transform": {
            "x": 0,
            "y": 0,
            "width": 256,
            "height": 256,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 1,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": {
            "width": 256,
            "height": 256,
            "color": "#1877f2"
          }
        }
      ],
      "internalBindings": [],
      "actions": []
    }
  ],
  "scenes": [
    {
      "id": "intro",
      "name": "Intro",
      "duration": 5,
      "space": "flat-2d",
      "layers": [
        {
          "id": "title",
          "type": "text",
          "parentLayerId": null,
          "transform": {
            "x": 0,
            "y": -200,
            "width": 800,
            "height": 120,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 1,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": {
            "content": {
              "kind": "plain",
              "text": "Hello MotiClip"
            },
            "fontSize": 64,
            "color": "#111111",
            "alignment": "center"
          }
        },
        {
          "id": "subtitle",
          "type": "text",
          "parentLayerId": null,
          "transform": {
            "x": 0,
            "y": 200,
            "width": 700,
            "height": 80,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 1,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": {
            "content": {
              "kind": "plain",
              "text": "Powered by V3"
            },
            "fontSize": 40,
            "color": "#555555",
            "alignment": "center"
          }
        },
        {
          "id": "logo-img",
          "type": "image",
          "parentLayerId": null,
          "transform": {
            "x": 0,
            "y": -80,
            "width": 200,
            "height": 200,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 0.9,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": {
            "assetId": "logo-png",
            "fit": "contain"
          }
        },
        {
          "id": "cam",
          "type": "camera",
          "parentLayerId": null,
          "transform": {
            "x": 0,
            "y": 0,
            "width": 0,
            "height": 0,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 1,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": {
            "projection": "orthographic",
            "zoom": 1
          }
        }
      ],
      "clips": [
        {
          "id": "title-fade-in",
          "layerId": "title",
          "schedule": {
            "kind": "absolute",
            "at": 0
          },
          "duration": 1,
          "playback": {},
          "source": {
            "kind": "tracks",
            "tracks": [
              {
                "layerId": "title",
                "property": "transform.opacity",
                "keys": [
                  {
                    "t": 0,
                    "v": 0,
                    "easing": "easeOut"
                  },
                  {
                    "t": 1,
                    "v": 1
                  }
                ]
              }
            ]
          }
        }
      ],
      "activeCameraLayerId": "cam"
    },
    {
      "id": "outro",
      "name": "Outro",
      "duration": 3,
      "space": "flat-2d",
      "layers": [
        {
          "id": "thanks",
          "type": "text",
          "parentLayerId": null,
          "transform": {
            "x": 0,
            "y": 0,
            "width": 700,
            "height": 100,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 1,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": {
            "content": {
              "kind": "plain",
              "text": "Thanks for watching"
            },
            "fontSize": 48,
            "color": "#111111",
            "alignment": "center"
          }
        }
      ],
      "clips": []
    }
  ],
  "timeline": {
    "duration": 8,
    "workArea": {
      "start": 0,
      "end": 8
    },
    "visualTracks": [
      {
        "id": "main-track",
        "order": 0,
        "clips": [
          {
            "id": "clip-intro",
            "source": {
              "kind": "scene",
              "sceneId": "intro"
            },
            "start": 0,
            "duration": 5,
            "opacity": 1,
            "loop": false
          },
          {
            "id": "clip-outro",
            "source": {
              "kind": "scene",
              "sceneId": "outro"
            },
            "start": 5,
            "duration": 3,
            "opacity": 1,
            "loop": false
          }
        ]
      }
    ],
    "audioTracks": [
      {
        "id": "track-bgm",
        "clips": [
          {
            "id": "track-bgm-clip",
            "assetId": "bgm",
            "start": 0,
            "duration": 8,
            "trimStart": 0,
            "playbackRate": 1,
            "volume": 0.8,
            "loop": false,
            "fadeIn": 0.5,
            "fadeOut": 1,
            "muted": false
          }
        ],
        "order": -1
      }
    ],
    "captionTracks": [
      {
        "id": "caption-vi",
        "locale": "vi-VN",
        "tokens": [
          {
            "id": "tok-1",
            "text": "Xin chào",
            "start": 0,
            "end": 1.2
          },
          {
            "id": "tok-2",
            "text": "MotiClip",
            "start": 1.3,
            "end": 2.5
          }
        ],
        "style": {
          "fontSize": 48,
          "fill": "#ffffff",
          "safeArea": "tiktok",
          "position": "bottom"
        },
        "animation": {
          "presetId": "word-pop"
        }
      }
    ]
  },
  "bindings": [
    {
      "id": "binding-founder-name",
      "source": {
        "kind": "variable",
        "variableId": "founder-name"
      },
      "target": {
        "kind": "scene",
        "sceneId": "intro",
        "layerId": "subtitle",
        "property": "payload.text"
      }
    },
    {
      "id": "binding-title-opacity",
      "source": {
        "kind": "variable",
        "variableId": "title-opacity"
      },
      "target": {
        "kind": "scene",
        "sceneId": "intro",
        "layerId": "title",
        "property": "transform.opacity"
      }
    }
  ]
}
