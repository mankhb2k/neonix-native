{
  "format": "motion-project",
  "formatVersion": 3,
  "metadata": {
    "id": "v3-representative",
    "name": "V3 Representative",
    "description": "Covers scene, visual track, audio, captions, tokens, variables",
    "locale": "vi-VN",
    "tags": ["demo", "v3"]
  },
  "composition": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "background": "#ffffff",
    "colorSpace": "srgb",
    "audioSampleRate": 48000,
    "safeArea": { "top": 0.1, "right": 0.05, "bottom": 0.15, "left": 0.05 },
    "motionBlur": { "samples": 8, "shutterAngle": 180, "shutterPhase": 0 }
  },
  "capabilities": {
    "required": ["primitive.group", "primitive.text", "primitive.image"],
    "optional": ["effect.blur"]
  },
  "dependencies": {
    "compiler": { "range": ">=1.0.0" },
    "components": [
      {
        "componentId": "logo-reveal",
        "version": "1.0.0",
        "integrity": "sha256:logo-reveal-1.0.0"
      }
    ]
  },
  "tokens": {
    "colors": { "brand": "#1877f2", "accent": "#ff5722" },
    "fonts": { "display": "font-inter" },
    "spacing": { "unit": 8 }
  },
  "variables": [
    {
      "id": "founder-name",
      "name": "Founder name",
      "type": "string",
      "value": "Mark Zuckerberg"
    },
    {
      "id": "brand-color",
      "name": "Brand color",
      "type": "color",
      "value": "#1877f2"
    },
    {
      "id": "title-opacity",
      "name": "Title opacity",
      "type": "number",
      "value": 0.9,
      "min": 0,
      "max": 1
    },
    {
      "id": "show-subtitle",
      "name": "Show subtitle",
      "type": "boolean",
      "value": true
    }
  ],
  "assets": [
    {
      "id": "logo-png",
      "uri": "./assets/images/logo.png",
      "integrity": "sha256:logo-png",
      "assetType": "image",
      "mimeType": "image/png",
      "width": 512,
      "height": 512,
      "pixelFormat": "rgba",
      "hasAlpha": true
    },
    {
      "id": "bgm",
      "uri": "./assets/audio/bgm.mp3",
      "integrity": "sha256:bgm",
      "assetType": "audio",
      "mimeType": "audio/mpeg",
      "duration": 42.5,
      "codec": "mp3",
      "sampleRate": 48000,
      "channels": 2
    }
  ],
  "components": [
    {
      "id": "logo-reveal",
      "version": "1.0.0",
      "integrity": "sha256:logo-reveal-1.0.0",
      "publicParams": [],
      "publicTargets": [
        {
          "id": "logo-visible",
          "name": "Logo Visible",
          "nodeId": "logo",
          "property": "transform.visible"
        },
        {
          "id": "logo-color",
          "name": "Logo Color",
          "nodeId": "logo",
          "property": "payload.color"
        }
      ],
      "variables": [],
      "nodes": [
        {
          "id": "logo",
          "type": "solid",
          "parentId": null,
          "transform": {
            "x": 0,
            "y": 0,
            "width": 256,
            "height": 256,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 1,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": { "width": 256, "height": 256, "color": "#1877f2" }
        }
      ],
      "bindings": [],
      "actions": []
    }
  ],
  "scenes": [
    {
      "id": "intro",
      "name": "Intro",
      "duration": 5,
      "space": "flat-2d",
      "nodes": [
        {
          "id": "title",
          "type": "text",
          "parentId": null,
          "transform": {
            "x": 0,
            "y": -200,
            "width": 800,
            "height": 120,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 1,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": {
            "content": { "kind": "plain", "text": "Hello MotiClip" },
            "fontSize": 64,
            "color": "#111111",
            "alignment": "center"
          }
        },
        {
          "id": "subtitle",
          "type": "text",
          "parentId": null,
          "transform": {
            "x": 0,
            "y": 200,
            "width": 700,
            "height": 80,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 1,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": {
            "content": { "kind": "plain", "text": "Powered by V3" },
            "fontSize": 40,
            "color": "#555555",
            "alignment": "center"
          }
        },
        {
          "id": "logo-img",
          "type": "image",
          "parentId": null,
          "transform": {
            "x": 0,
            "y": -80,
            "width": 200,
            "height": 200,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 0.9,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": { "assetId": "logo-png", "fit": "contain" }
        },
        {
          "id": "cam",
          "type": "camera",
          "parentId": null,
          "transform": {
            "x": 0,
            "y": 0,
            "width": 0,
            "height": 0,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 1,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": {
            "projection": "orthographic",
            "zoom": 1
          }
        }
      ],
      "clips": [
        {
          "id": "title-fade-in",
          "targetId": "title",
          "schedule": { "kind": "absolute", "at": 0 },
          "duration": 1,
          "playback": {},
          "source": {
            "kind": "tracks",
            "tracks": [
              {
                "targetId": "title",
                "property": "transform.opacity",
                "keys": [
                  { "t": 0, "v": 0, "easing": "easeOut" },
                  { "t": 1, "v": 1 }
                ]
              }
            ]
          }
        }
      ],
      "activeCameraId": "cam"
    },
    {
      "id": "outro",
      "name": "Outro",
      "duration": 3,
      "space": "flat-2d",
      "nodes": [
        {
          "id": "thanks",
          "type": "text",
          "parentId": null,
          "transform": {
            "x": 0,
            "y": 0,
            "width": 700,
            "height": 100,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 1,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": {
            "content": { "kind": "plain", "text": "Thanks for watching" },
            "fontSize": 48,
            "color": "#111111",
            "alignment": "center"
          }
        }
      ],
      "clips": []
    }
  ],
  "timeline": {
    "duration": 8,
    "workArea": { "start": 0, "end": 8 },
    "visualTracks": [
      {
        "id": "main-track",
        "role": "main",
        "order": 0,
        "clips": [
          {
            "id": "clip-intro",
            "source": { "kind": "scene", "sceneId": "intro" },
            "start": 0,
            "duration": 5,
            "opacity": 1,
            "loop": false,
            "transitionOut": {
              "type": "fade",
              "duration": 0.5,
              "color": "#000000",
              "easing": "easeInOut"
            }
          },
          {
            "id": "clip-outro",
            "source": { "kind": "scene", "sceneId": "outro" },
            "start": 5,
            "duration": 3,
            "opacity": 1,
            "loop": false
          }
        ]
      }
    ],
    "audioTracks": [
      {
        "id": "track-bgm",
        "role": "bgm",
        "assetId": "bgm",
        "start": 0,
        "duration": 42.5,
        "trimStart": 0,
        "playbackRate": 1,
        "volume": 0.8,
        "loop": false,
        "fadeIn": 0.5,
        "fadeOut": 1,
        "muted": false
      }
    ],
    "captionTracks": [
      {
        "id": "caption-vi",
        "locale": "vi-VN",
        "tokens": [
          {
            "id": "tok-1",
            "text": "Xin chào",
            "start": 0,
            "end": 1.2
          },
          {
            "id": "tok-2",
            "text": "MotiClip",
            "start": 1.3,
            "end": 2.5
          }
        ],
        "style": {
          "fontSize": 48,
          "fill": "#ffffff",
          "safeArea": "tiktok",
          "position": "bottom"
        },
        "animation": { "presetId": "word-pop" }
      }
    ]
  },
  "bindings": [
    {
      "id": "binding-founder-name",
      "source": { "kind": "variable", "variableId": "founder-name" },
      "target": {
        "kind": "scene",
        "sceneId": "intro",
        "nodeId": "subtitle",
        "property": "payload.text"
      }
    },
    {
      "id": "binding-title-opacity",
      "source": { "kind": "variable", "variableId": "title-opacity" },
      "target": {
        "kind": "scene",
        "sceneId": "intro",
        "nodeId": "title",
        "property": "transform.opacity"
      }
    }
  ]
}
