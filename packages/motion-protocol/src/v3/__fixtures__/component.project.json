{
  "format": "motion-project",
  "formatVersion": 3,
  "metadata": {
    "id": "v3-component",
    "name": "V3 Component Example",
    "description": "Demonstrates embedded component definition and component-source visual clips",
    "locale": "vi-VN",
    "tags": ["example", "v3", "component"]
  },
  "composition": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "background": "#ffffff",
    "colorSpace": "srgb",
    "audioSampleRate": 48000
  },
  "capabilities": {
    "required": ["primitive.text", "primitive.solid", "component.embedding"]
  },
  "dependencies": {
    "compiler": { "range": ">=1.0.0" },
    "components": [
      {
        "componentId": "call-to-action",
        "version": "1.0.0",
        "source": "com.moticlip.store",
        "integrity": "sha256:cta-1.0.0"
      }
    ]
  },
  "tokens": {},
  "variables": [
    {
      "id": "cta-text",
      "name": "CTA Button Text",
      "type": "string",
      "value": "Tìm hiểu thêm"
    }
  ],
  "assets": [],
  "components": [
    {
      "id": "call-to-action",
      "version": "1.0.0",
      "integrity": "sha256:cta-1.0.0",
      "publicParams": [
        {
          "id": "label",
          "name": "Button label",
          "variableId": "cta-label",
          "type": "string"
        },
        {
          "id": "color",
          "name": "Button color",
          "variableId": "cta-color",
          "type": "color"
        }
      ],
      "slots": [
        {
          "id": "icon",
          "name": "Leading icon",
          "accepts": ["image", "svg"],
          "count": 1
        }
      ],
      "variants": [
        {
          "id": "primary",
          "name": "Primary CTA",
          "params": { "color": "#1877f2", "label": "Click me" }
        },
        {
          "id": "outline",
          "name": "Outline CTA",
          "params": { "color": "#ffffff", "label": "Learn more" }
        }
      ],
      "publicTargets": [
        {
          "id": "cta-label",
          "name": "Button label text",
          "nodeId": "cta-label-node",
          "property": "payload.content.text",
          "description": "The visible text content of the CTA button"
        }
      ],
      "variables": [
        {
          "id": "cta-label",
          "name": "CTA Label",
          "type": "string",
          "value": "Click me"
        },
        {
          "id": "cta-color",
          "name": "CTA Color",
          "type": "color",
          "value": "#1877f2"
        }
      ],
      "nodes": [
        {
          "id": "cta-bg",
          "type": "solid",
          "parentId": null,
          "transform": {
            "x": 0,
            "y": 0,
            "width": 600,
            "height": 120,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 1,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": { "width": 600, "height": 120, "color": "#1877f2" }
        },
        {
          "id": "cta-label-node",
          "type": "text",
          "parentId": "cta-bg",
          "transform": {
            "x": 0,
            "y": 0,
            "width": 500,
            "height": 60,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 1,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": {
            "content": { "kind": "plain", "text": "Click me" },
            "fontSize": 40,
            "color": "#ffffff",
            "alignment": "center"
          }
        }
      ],
      "bindings": [],
      "actions": [
        {
          "id": "cta-tap",
          "name": "Button tap animation",
          "clips": []
        }
      ]
    }
  ],
  "scenes": [
    {
      "id": "landing",
      "name": "Landing Page",
      "duration": 5,
      "nodes": [
        {
          "id": "title",
          "type": "text",
          "parentId": null,
          "transform": {
            "x": 0,
            "y": -200,
            "width": 800,
            "height": 120,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 1,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": {
            "content": { "kind": "plain", "text": "Welcome to MotiClip" },
            "fontSize": 56,
            "color": "#111111",
            "alignment": "center"
          }
        }
      ]
    }
  ],
  "timeline": {
    "visualTracks": [
      {
        "id": "main",
        "role": "main",
        "order": 0,
        "clips": [
          {
            "id": "c-landing",
            "source": { "kind": "scene", "sceneId": "landing" },
            "start": 0,
            "duration": 5
          }
        ]
      },
      {
        "id": "overlay-cta",
        "role": "overlay",
        "order": 1,
        "clips": [
          {
            "id": "c-cta",
            "source": { "kind": "component", "componentId": "call-to-action" },
            "start": 1,
            "duration": 2.5,
            "transitionIn": {
              "type": "fade",
              "duration": 0.3,
              "easing": "easeOut"
            },
            "transitionOut": {
              "type": "fade",
              "duration": 0.3,
              "easing": "easeIn"
            }
          }
        ]
      }
    ]
  },
  "bindings": [
    {
      "id": "bind-cta",
      "source": { "kind": "variable", "variableId": "cta-text" },
      "target": {
        "kind": "component",
        "componentId": "call-to-action",
        "targetId": "cta-label"
      }
    }
  ]
}
