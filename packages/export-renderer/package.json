{
  "name": "@motionvideo/export-renderer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./src/contracts/index.ts",
    "./server": "./src/api/server.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test -c ../../eslint.package.mjs --max-warnings 0",
    "start": "tsx src/api/server.ts",
    "render:smoke": "tsx src/cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@motionvideo/motion-runtime": "workspace:*",
    "@motionvideo/skia-renderer": "workspace:*",
    "canvaskit-wasm": "0.42.0",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  }
}
