{
  "name": "@motionvideo/render-native",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./contracts": "./dist/contracts/index.js",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "build:contracts": "tsc -p tsconfig.contracts.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test -c ../../eslint.package.mjs --max-warnings 0",
    "render:smoke": "tsx src/cli.ts",
    "benchmark:libyuv-color-contract": "tsx src/benchmark-libyuv-color-contract.ts",
    "benchmark:mp4-color-suite": "tsx src/benchmark-mp4-color-suite-5s.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@motionvideo/html-compiler": "workspace:*",
    "@motionvideo/motion-runtime": "workspace:*",
    "sharp": "^0.34.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2",
    "vitest": "^4.1.10"
  }
}
