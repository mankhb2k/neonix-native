{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neonix-media-events",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "queues": {
    "consumers": [
      {
        "queue": "neonix-media-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "neonix-media-events-dlq",
        "max_concurrency": 2,
        "retry_delay": 30
      }
    ]
  }
}
