{
  "apiVersion": "run.googleapis.com/v1",
  "kind": "Job",
  "metadata": {
    "name": "neonix-skia-command-cpu-bench-r4"
  },
  "spec": {
    "template": {
      "spec": {
        "parallelism": 1,
        "taskCount": 1,
        "template": {
          "spec": {
            "containers": [
              {
                "env": [
                  { "name": "BENCHMARK_MODE", "value": "in-process" },
                  { "name": "BENCHMARK_COLOR_CONVERTER", "value": "libyuv" },
                  { "name": "BENCHMARK_SURFACE_MODE", "value": "direct-raster" },
                  { "name": "BENCHMARK_PROTOCOL_TRANSPORT", "value": "file" },
                  { "name": "BENCHMARK_DURATION_SECONDS", "value": "60" },
                  { "name": "BENCHMARK_FRAMES", "value": "1800" },
                  { "name": "FFMPEG_THREADS", "value": "4" },
                  { "name": "BENCHMARK_PROTOCOL_BATCH_FRAMES", "value": "1" }
                ],
                "image": "asia-southeast1-docker.pkg.dev/neonix-506607/neonix/skia-command-cpu-bench@sha256:99c65978b1edc01107cba0fd4dd0e43e5f6ebb9e3148ae19674f6bfa6208b23c",
                "resources": {
                  "limits": { "cpu": "4", "memory": "16Gi" }
                }
              }
            ],
            "maxRetries": 0,
            "timeoutSeconds": "3600",
            "serviceAccountName": "540893712425-compute@developer.gserviceaccount.com"
          }
        }
      }
    }
  }
}
