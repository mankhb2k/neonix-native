# Native production target. It uses the same command-buffer protocol and
# in-process FFmpeg encoder, and links libyuv for BT.709 color conversion.
# This is the only target this Dockerfile's `ninja` invocation builds; every
# other variant (GPU/Vulkan backend, non-libyuv backend, libyuv/swscale A/B
# sandbox, standalone color contract test) lived in the archived benchmark
# Dockerfiles and referenced source files this production image never copies
# in — keep this file limited to what this Dockerfile actually builds.
test_app("neonix_skia_command_cpu_backend_libyuv") {
  sources = [
    "neonix/util.h",
    "neonix/protocol.h",
    "neonix/protocol.cpp",
    "neonix/paint.h",
    "neonix/paint.cpp",
    "neonix/effects.h",
    "neonix/effects.cpp",
    "neonix/encoder.h",
    "neonix/encoder.cpp",
    "neonix/main.cpp",
  ]
  deps = [ ":skia" ]
  defines = [ "NEONIX_ENABLE_LIBYUV", "NEONIX_LIBYUV_ONLY" ]
  include_dirs = [ "/opt/libyuv-install/include" ]
  lib_dirs = [ "/opt/libyuv-install/lib" ]
  libs = [ "avcodec", "avformat", "avutil", "yuv" ]
}
