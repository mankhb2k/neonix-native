{
  "name": "@motionvideo/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Electron shell + Vite renderer for MotionVideo (legacy Next still available).",
  "author": "MotionVideo",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "pnpm run dev:vite",
    "dev:renderer": "vite",
    "dev:electron": "pnpm build:main && pnpm build:preload && wait-on http://127.0.0.1:5173 && cross-env MOTIONVIDEO_RENDERER=vite electron .",
    "dev:vite": "concurrently -k -n renderer,electron -c cyan,magenta \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "dev:legacy": "pnpm build:main && pnpm build:preload && cross-env MOTIONVIDEO_RENDERER=legacy electron .",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/index.js --sourcemap && esbuild src/main/services/journal-validate-worker.ts --bundle --platform=node --format=cjs --outfile=dist/main/journal-validate-worker.js --sourcemap",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.js --sourcemap",
    "build:renderer": "vite build",
    "build:main:release": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main/index.js && esbuild src/main/services/journal-validate-worker.ts --bundle --platform=node --format=cjs --outfile=dist/main/journal-validate-worker.js",
    "build:preload:release": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.js",
    "build:renderer:release": "cross-env MOTIONVIDEO_RELEASE=1 vite build",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:export-cli": "node scripts/build-export-cli.mjs",
    "test:export-cli": "pnpm build:export-cli && node scripts/smoke-export-cli.mjs",
    "bench:export-split": "node scripts/bench-export-split.mjs",
    "test:e2e:lifecycle": "node scripts/e2e-packaged-lifecycle.mjs",
    "build:release": "pnpm build:main:release && pnpm build:preload:release && pnpm build:renderer:release && pnpm build:export-cli",
    "build:desktop": "pnpm build",
    "pack": "pnpm build:release && pnpm test:export-cli && electron-builder --win dir",
    "dist": "pnpm build:release && pnpm test:export-cli && electron-builder --win nsis",
    "electron:pack": "pnpm run pack",
    "electron:dist": "pnpm run dist",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:ci": "eslint . --max-warnings 0",
    "test:desktop-paths": "pnpm build:main && node scripts/smoke-desktop-paths.mjs",
    "test:journal-worker": "pnpm build:main && node scripts/smoke-journal-validate-worker.mjs",
    "test:journal-worker:packaged": "node scripts/smoke-journal-validate-worker-packaged.mjs",
    "test:web-ban": "node scripts/probe-web-import-ban.mjs && node scripts/probe-legacy-desktop-protected.mjs",
    "test": "vitest run --project node --project dom",
    "test:perf": "vitest run --project perf",
    "test:perf:electron": "node scripts/perf-electron-harness.mjs",
    "capture:baselines": "node scripts/capture-parity-baselines.mjs --electron",
    "capture:geometry": "cross-env VITE_ENABLE_UI_FIXTURES=1 pnpm build:renderer && node scripts/launch-electron-clean.mjs scripts/capture-geometry-metrics.cjs",
    "capture:reference-web": "node scripts/capture-reference-web.mjs",
    "compare:baselines": "node scripts/compare-baselines.mjs",
    "compare:geometry": "node scripts/compare-geometry.mjs",
    "start": "electron .",
    "start:prod": "pnpm build && cross-env MOTIONVIDEO_VITE_PROD=1 electron .",
    "start:vite:prod": "pnpm run start:prod"
  },
  "dependencies": {
    "@motionvideo/editor-core": "workspace:*",
    "@motionvideo/motion-compiler": "workspace:*",
    "@motionvideo/motion-runtime": "workspace:*",
    "@motionvideo/motion-schema": "workspace:*",
    "clsx": "^2.1.1",
    "lucide-react": "^1.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/runtime": "^8.0.0",
    "@eslint/js": "^9.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^37.2.5",
    "electron-builder": "^26.15.3",
    "enhanced-resolve": "5.18.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.22.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^18.0.1",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "app.motionvideo.desktop",
    "productName": "MotionVideo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "dist-renderer/**/*",
      "!dist-renderer/**/*.map",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/main/journal-validate-worker.js"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "resources/export-cli",
        "to": "export-cli",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
