{
  "extends": "./tsconfig.gui.json",
  "compilerOptions": {
    "module": "ESNext",
    "noImplicitAny": false,
    "types": ["node", "vitest/globals"],
    "paths": {
      "@gui/*": ["gui/*"],
      "@editor-core-fixtures/*": [
        "../../packages/editor-core/src/testing/fixtures/*"
      ]
    }
  },
  "include": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "../../packages/editor-core/src/testing/fixtures/**/*.ts"
  ],
  "exclude": []
}
