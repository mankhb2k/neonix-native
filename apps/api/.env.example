# Copy to apps/api/.env for local development.

PORT=8080

# Local dev: docker-compose.dev.yml (postgres on 5433, redis on 6380).
# Staging/production: real Neon connection string + managed Redis URL.
DATABASE_URL=postgres://api:api@localhost:5433/api
REDIS_URL=redis://localhost:6380

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=<random-hex-secret>
BETTER_AUTH_URL=http://localhost:8080
WEB_APP_URL=http://localhost:3000

# Run scripts/seed-test-account.ts, then paste the two ids it prints here.
# Stands in for a real authenticated user until Phase 2's OAuth cutover is
# done - see src/auth/current-user.guard.ts.
SEED_USER_ID=<seed-user-id>
SEED_WORKSPACE_ID=<seed-workspace-id>

# Same R2 account/bucket as apps/web - see apps/web/.env for the real values.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_USER_ASSETS_BUCKET=neonix-user-assets

# Same Cloud Run export renderer as apps/web - see apps/web/.env for the
# real values. Its deployed Job still reads render_jobs from Supabase, not
# Neon, until that's redeployed separately.
EXPORT_RENDERER_URL=<cloud-run-service-url>
INTERNAL_WORKER_TOKEN=<internal-worker-token>

# Same Polar org/product as apps/web - see apps/web/.env for the real values.
# Not configured yet in either app's real .env (sandbox-only feature so far),
# so leaving these unset is fine for local dev - balance/ledger routes still
# work, only checkout creation and the webhook need them.
POLAR_ACCESS_TOKEN=<polar-organization-access-token>
POLAR_ENVIRONMENT=sandbox
POLAR_WEBHOOK_SECRET=<polar-webhook-secret>
POLAR_TOPUP_PRODUCT_ID=<polar-product-id>
