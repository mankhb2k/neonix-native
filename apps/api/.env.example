# Copy to apps/api/.env for local development.

PORT=8080

# Optional Glama.ai hosted MCP connector domain-ownership challenge token.
GLAMA_CLAIM_TOKEN=

# Optional OpenAI Apps directory domain-verification challenge token.
OPENAI_APPS_CHALLENGE_TOKEN=

# Local dev: docker-compose.dev.yml (postgres on 5433, redis on 6380).
# Staging/production: real Neon connection string + managed Redis URL.
DATABASE_URL=postgres://api:api@localhost:5433/api
REDIS_URL=redis://localhost:6380

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=<random-hex-secret>
BETTER_AUTH_URL=http://localhost:8080
WEB_APP_URL=http://localhost:3000
# Comma-separated extra origins (marketing site, preview deploys) allowed to
# call the API with credentials, beyond WEB_APP_URL. Empty/unset is fine
# locally.
ADDITIONAL_TRUSTED_ORIGINS=
# Unset locally (both sides are on localhost, no shared parent domain to
# scope the session cookie to). In production: .neonix.video - see auth.ts.
COOKIE_DOMAIN=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>

# Run scripts/seed-test-account.ts, then paste the two ids it prints here.
# Used as the fixture user/workspace id in HTTP-layer controller tests
# (auth is stubbed there via CurrentUserGuard's test override - see
# src/test/seed-user-guard.ts - not by this env var directly).
SEED_USER_ID=<seed-user-id>
SEED_WORKSPACE_ID=<seed-workspace-id>

# Same R2 account/bucket as apps/web - see apps/web/.env for the real values.
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret>
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_USER_ASSETS_BUCKET=neonix-user-assets
# Public-read bucket (custom domain attached) for profile avatars - separate
# from R2_USER_ASSETS_BUCKET, which stays private/presigned-only.
R2_AVATARS_BUCKET=neonix-user-avatar
R2_AVATARS_PUBLIC_URL=https://users-avatar.neonix.video

# Curated system font/asset catalog (read-only from this app's perspective -
# see src/db/schema/system-catalog.ts). Font bytes are served publicly by the
# separate fonts.neonix.video Cloudflare Worker straight from R2, not
# proxied through this API; system-assets (fallback placeholders) has no
# such CDN, so this API streams those bytes itself.
R2_SYSTEM_FONTS_BUCKET=neonix-system-fonts
R2_SYSTEM_ASSETS_BUCKET=neonix-system-assets

# Finished render (MP4) storage - presigned GET only, for the render download URL route.
R2_USER_EXPORTS_BUCKET=neonix-user-exports

# Same Cloud Run export renderer as apps/web - see apps/web/.env for the
# real values. Its deployed Job reads render_jobs from the API database.
EXPORT_RENDERER_URL=<cloud-run-service-url>
INTERNAL_WORKER_TOKEN=<internal-worker-token>

# Same Polar org/product as apps/web - see apps/web/.env for the real values.
# Not configured yet in either app's real .env (sandbox-only feature so far),
# so leaving these unset is fine for local dev - balance/ledger routes still
# work, only checkout creation and the webhook need them.
POLAR_ACCESS_TOKEN=<polar-organization-access-token>
POLAR_ENVIRONMENT=sandbox
POLAR_WEBHOOK_SECRET=<polar-webhook-secret>
POLAR_TOPUP_PRODUCT_ID=<polar-product-id>
