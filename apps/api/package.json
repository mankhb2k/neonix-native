{
  "name": "@motionvideo/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm build && concurrently -k -n tsc,node \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src -c ../../eslint.package.mjs --max-warnings 0",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "@better-auth/mcp": "^1.7.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@motionvideo/html-compiler": "workspace:*",
    "@motionvideo/motion-mcp": "workspace:*",
    "@motionvideo/motion-runtime": "workspace:*",
    "@motionvideo/render-native": "workspace:*",
    "@whatwg-node/server": "^0.13.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@polar-sh/sdk": "^1.0.0",
    "better-auth": "^1.3.31",
    "bullmq": "^5.60.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "ioredis": "^5.9.1",
    "jose": "^6.1.3",
    "multer": "^2.4.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.1",
    "@swc/core": "^1.16.12",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "concurrently": "^10.0.5",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.1.4",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.10"
  }
}
