# Neonix Web environment
# Copy this file to apps/web/.env for local development.
# Vercel environment variables belong to the Web project as well.

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000/app
# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_key>

# Server-only. Never expose or send to MCP clients.
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# Used by the Remote MCP OAuth token verifier.
SUPABASE_OAUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
MCP_SERVER_URL=http://localhost:3000/api/mcp

# Development-only demo account. Never enable this in production.
DEV_DEMO_AUTH=0
DEV_DEMO_EMAIL=demo1@gmail.com
DEV_DEMO_PASSWORD=<local-only-demo-password>

# -----------------------------------------------------------------------------
# R2 object storage (server-only)
# -----------------------------------------------------------------------------
# The Web API creates presigned URLs; browsers upload directly to R2.
MOTION_STORAGE_PROVIDER=memory
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret>
R2_USER_ASSETS_BUCKET=neonix-user-assets
R2_USER_EXPORTS_BUCKET=neonix-user-exports
R2_SYSTEM_ASSETS_BUCKET=neonix-system-assets
# Optional custom S3-compatible endpoint.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Optional public custom-domain read endpoint. Leave unset for private buckets;
# the editor uses short-lived presigned URLs by default.
# R2_PUBLIC_ASSETS_URL=https://assets.example.com

# -----------------------------------------------------------------------------
# Rendering (required for export; point this to the native VPS worker)
# -----------------------------------------------------------------------------
# EXPORT_RENDERER_URL=http://127.0.0.1:8787
# INTERNAL_WORKER_TOKEN=local-worker-secret
# MEDIA_CALLBACK_URL=http://host.docker.internal:3000

# -----------------------------------------------------------------------------
# Local development and tests
# -----------------------------------------------------------------------------
# MOTIONVIDEO_RENDER_JOBS_DIR=.tmp/render-jobs
# PLAYWRIGHT_PORT=3000
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# NEXT_PUBLIC_EXPORT_MOCK=1
