# Neonix Web environment
# Copy this file to apps/web/.env for local development.
# Vercel environment variables belong to the Web project as well.

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------
# Set one port per local project, for example 3001 or 3002.
PORT=3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000/app
# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_key>

# Server-only. Never expose or send to MCP clients.
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# Used by the Remote MCP OAuth token verifier.
SUPABASE_OAUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
MCP_SERVER_URL=http://localhost:3000/api/mcp

# Development-only demo account. Never enable this in production.
DEV_DEMO_AUTH=0
DEV_DEMO_EMAIL=demo1@gmail.com
DEV_DEMO_PASSWORD=<local-only-demo-password>

# -----------------------------------------------------------------------------
# R2 object storage (server-only)
# -----------------------------------------------------------------------------
# The Web API creates presigned URLs; browsers upload directly to R2.
MOTION_STORAGE_PROVIDER=memory
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key>
R2_SECRET_ACCESS_KEY=<r2-secret>
R2_USER_ASSETS_BUCKET=neonix-user-assets
R2_USER_EXPORTS_BUCKET=neonix-user-exports
R2_SYSTEM_ASSETS_BUCKET=neonix-system-assets
R2_SYSTEM_FONTS_BUCKET=neonix-system-fonts
# Optional custom S3-compatible endpoint.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Optional public custom-domain read endpoint. Leave unset for private buckets;
# the editor uses short-lived presigned URLs by default.
# R2_PUBLIC_ASSETS_URL=https://assets.example.com

# -----------------------------------------------------------------------------
# Rendering (required for export; the worker's MP4 source of truth is native Skia)
# -----------------------------------------------------------------------------
# EXPORT_RENDERER_URL=http://127.0.0.1:8787
# INTERNAL_WORKER_TOKEN=local-worker-secret
# RENDER_DISPATCH_MODE=service
# Set cloud-run-job when EXPORT_RENDERER_URL points to the Cloud Run control
# plane. The control plane submits only RENDER_JOB_ID.
# CLOUD_RUN_PROJECT_ID=neonix-506607
# CLOUD_RUN_REGION=asia-southeast1
# CLOUD_RUN_JOB_NAME=neonix-render-job
# Optional indexed chunk path. MVP renders as a single Cloud Run job; keep
# false until an 8 vCPU A/B benchmark justifies turning chunking back on.
# CLOUD_RUN_CHUNK_JOB_NAME=neonix-render-chunk-job
# CLOUD_RUN_FINALIZER_JOB_NAME=neonix-render-finalizer-job
# RENDER_CHUNK_EXECUTION_ENABLED=false
# Set true only when a render queue consumer is running.
# RENDER_QUEUE_ENABLED=false
# RENDER_QUEUE_POLL_MS=1000
# RENDER_QUEUE_VISIBILITY_TIMEOUT_SECONDS=900
# RENDER_QUEUE_MAX_ATTEMPTS=5
# RENDER_QUEUE_STALE_SECONDS=1800
# RENDER_QUEUE_RECOVERY_INTERVAL_MS=30000
# RENDER_QUEUE_WORKER_ID=
# RENDER_QUEUE_STATUS_POLL_MS=1000
# RENDER_QUEUE_STATUS_TIMEOUT_MS=1800000
# Test-only: stop the consumer after the first message is handled.
# RENDER_QUEUE_EXIT_AFTER_ONE=false
# RENDER_JOB_CHUNK_RETRIES=1
# RENDER_FINALIZER_RETRIES=1
# RENDER_JOB_STALE_AFTER_SECONDS=1800
# Indexed chunk lease recovery should normally be shorter than the queue
# visibility timeout so a vanished Cloud Run task can be resubmitted.
# RENDER_JOB_CHUNK_STALE_AFTER_SECONDS=300
# RENDER_CHUNK_RECOVERY_INTERVAL_MS=30000
# MEDIA_CALLBACK_URL=http://host.docker.internal:3000
# Cloudflare R2 object-create events sign requests to this internal endpoint.
# Keep this secret different from INTERNAL_WORKER_TOKEN.
# MEDIA_EVENT_HMAC_SECRET=local-media-event-secret

# -----------------------------------------------------------------------------
# Layout snapshot (optional; disabled by default - see infra/cloud-run/layout-probe)
# -----------------------------------------------------------------------------
# Feeds a real-Chromium-measured layout snapshot into the HTML save path's
# compileDocument() call. Any failure (unset, unreachable, timeout) silently
# falls back to plain native compilation - never blocks a save.
# LAYOUT_SNAPSHOT_ENABLED=false
# LAYOUT_SNAPSHOT_URL=http://127.0.0.1:8788
# LAYOUT_SNAPSHOT_TIMEOUT_MS=5000
# Reuses INTERNAL_WORKER_TOKEN above - no separate secret.

# Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>` when it
# calls /api/internal/cron/storage-maintenance (see apps/web/vercel.json).
# Required in production; without it the route always returns 401.
# CRON_SECRET=local-cron-secret

# -----------------------------------------------------------------------------
# Local development and tests
# -----------------------------------------------------------------------------
# MOTIONVIDEO_RENDER_JOBS_DIR=.tmp/render-jobs
# PLAYWRIGHT_PORT=3000
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# NEXT_PUBLIC_EXPORT_MOCK=1
