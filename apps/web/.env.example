# Neonix Web environment
# Copy this file to apps/web/.env.local for local development.
#
# Vercel Production values are documented below. Set the same three public
# variables in Vercel Project Settings > Environment Variables for Production.

PORT=3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000/app
# Base URL for the backend in apps/api. Production uses the API deployment origin.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEV_DEMO_EMAIL=demo@gmail.com
NEXT_PUBLIC_DEV_DEMO_PASSWORD=demo123@

# Vercel Production:
# NEXT_PUBLIC_MARKETING_URL=https://www.neonix.video
# NEXT_PUBLIC_APP_URL=https://app.neonix.video
# NEXT_PUBLIC_API_URL=https://api.neonix.video

# The API's database, Redis, R2, renderer, and internal token variables belong
# to apps/api/ on EC2. They are not required by the Next.js frontend on Vercel.

# Optional browser smoke-test behavior.
# NEXT_PUBLIC_EXPORT_MOCK=1
