{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "e2e/**/*.ts",
    "e2e/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-*",
    "out",
    "build",
    "public"
  ]
}
