{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-backend-order-e2e/types/**/*.ts",
    ".next-dev/types/**/*.ts",
    ".next-v2-e2e/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-agent-test/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e",
    "components/editor",
    "hooks/editor",
    "lib/editor",
    "**/*.test.ts",
    "**/*.test.tsx",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.editor.config.ts",
    "tsconfig.editor.json"
  ]
}
