    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "eslint-import-resolver-typescript": "^4.2.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-web-api": "^5.18.6",
    "happy-dom": "^20.11.1",
