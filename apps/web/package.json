{
  "name": "@motionvideo/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:editor": "tsc --noEmit -p tsconfig.editor.json",
    "test:editor": "vitest run --config vitest.editor.config.ts",
    "seed:demo-user": "tsx scripts/seed-demo-user.ts",
    "test:editor:watch": "vitest --config vitest.editor.config.ts",
    "test": "pnpm run test:editor",
    "test:watch": "pnpm run test:editor:watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@motionvideo/editor-core": "workspace:*",
    "@motionvideo/motion-compiler": "workspace:*",
    "@motionvideo/motion-mcp": "workspace:*",
    "@motionvideo/motion-protocol": "workspace:*",
    "@motionvideo/motion-runtime": "workspace:*",
    "@motionvideo/motion-storage": "workspace:*",
    "@motionvideo/patterns": "workspace:*",
      "@motionvideo/playback-engine-next": "workspace:*",
    "@motionvideo/preview-renderer": "workspace:*",
    "@motionvideo/render-contracts": "workspace:*",
    "@remotion/lambda-client": "4.0.506",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.25.0",
    "next": "^15.2.4",
    "postcss": "^8.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
