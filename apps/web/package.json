    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.62.0",
    "@storybook/nextjs": "^10.5.3",
    "@storybook/react": "^10.5.3",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "eslint-import-resolver-typescript": "^4.2.2",
    "eslint-plugin-import": "^2.31.0",
    "happy-dom": "^20.11.1",
    "storybook": "^10.5.3",
    "tsx": "^4.23.1",
