{
  "name": "@motionvideo/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:desktop": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:ci": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
