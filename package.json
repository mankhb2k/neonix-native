{
  "name": "motionvideo",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm --filter @motionvideo/web dev",
    "dev:worker": "pnpm --filter @motionvideo/render-worker dev",
    "e2e:render": "pnpm --filter @motionvideo/render-worker e2e",
    "e2e:web": "pnpm --filter @motionvideo/web e2e",
    "build": "pnpm -r run build",
    "lint": "pnpm --filter @motionvideo/web lint",
    "lint:web": "pnpm --filter @motionvideo/web lint",
    "typecheck": "pnpm -r run typecheck",
    "validate:v2-fixtures": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/validate-motion-v2-fixtures.ts",
    "update:v2-goldens": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/update-motion-v2-goldens.ts",
    "update:v2-frame-goldens": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/update-motion-v2-frame-goldens.ts",
    "validate:primitives": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/validate-runtime-primitives.ts",
    "storybook": "pnpm --filter @motionvideo/web storybook"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
