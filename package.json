{
  "name": "motionvideo",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm --filter @motionvideo/web dev",
    "dev:desktop": "pnpm --filter @motionvideo/desktop dev",
    "dev:desktop:legacy": "pnpm --filter @motionvideo/desktop dev:legacy",
    "dev:desktop:vite": "pnpm --filter @motionvideo/desktop dev:vite",
    "dev:desktop:next": "pnpm --filter @motionvideo/web dev:desktop",
    "dev:worker": "pnpm --filter @motionvideo/render-worker dev",
    "e2e:render": "pnpm --filter @motionvideo/render-worker e2e",
    "e2e:web": "pnpm --filter @motionvideo/web e2e",
    "e2e:timeline": "pnpm --filter @motionvideo/web e2e:timeline",
    "build": "pnpm -r run build",
    "lint": "pnpm --filter @motionvideo/web lint && pnpm --filter @motionvideo/desktop lint && pnpm --filter @motionvideo/editor-core lint",
    "lint:web": "pnpm --filter @motionvideo/web lint",
    "lint:desktop": "pnpm --filter @motionvideo/desktop lint",
    "typecheck": "pnpm -r run typecheck",
    "validate:v2-fixtures": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/validate-motion-v2-fixtures.ts",
    "validate:capability-ledger": "pnpm validate:v2-fixtures",
    "validate:ai-fixtures": "pnpm --filter @motionvideo/ai-planner exec tsx ../../scripts/validate-ai-fixtures.ts",
    "eval:zero-template": "pnpm --filter @motionvideo/ai-planner exec tsx ../../scripts/run-zero-template-eval.ts",
    "update:v2-goldens": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/update-motion-v2-goldens.ts",
    "update:v2-frame-goldens": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/update-motion-v2-frame-goldens.ts",
    "validate:primitives": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/validate-runtime-primitives.ts",
    "validate:acceptance-export": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/validate-acceptance-export.ts",
    "validate:acceptance-web-parity": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/validate-acceptance-web-parity.ts",
    "score:designer-corrections": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/score-designer-corrections.ts",
    "score:acceptance-pack": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/score-acceptance-pack.ts",
    "storybook": "pnpm --filter @motionvideo/web storybook",
    "storybook:desktop": "pnpm --filter @motionvideo/desktop storybook"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "enhanced-resolve": "5.24.3"
    }
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "picomatch": "^4.0.5"
  }
}
