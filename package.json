{
  "name": "motionvideo",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm --filter @motionvideo/web dev",
    "dev:desktop": "pnpm --filter @motionvideo/desktop dev",
    "dev:desktop:legacy": "pnpm --filter @motionvideo/desktop dev:legacy",
    "dev:desktop:vite": "pnpm --filter @motionvideo/desktop dev:vite",
    "dev:desktop:next": "pnpm --filter @motionvideo/web dev:desktop",
    "dev:worker": "pnpm --filter @motionvideo/render-worker dev",
    "e2e:render": "pnpm --filter @motionvideo/render-worker e2e",
    "e2e:remotion": "pnpm --filter @motionvideo/remotion-site e2e",
    "e2e:web": "pnpm --filter @motionvideo/web e2e",
    "e2e:timeline": "pnpm --filter @motionvideo/web e2e:timeline",
    "build": "pnpm -r run build",
    "lint": "pnpm --filter @motionvideo/web lint && pnpm --filter @motionvideo/desktop lint && pnpm lint:packages",
    "lint:packages": "pnpm --filter \"./packages/*\" --if-present lint",
    "lint:web": "pnpm --filter @motionvideo/web lint",
    "lint:desktop": "pnpm --filter @motionvideo/desktop lint",
    "typecheck": "pnpm -r run typecheck",
    "validate:motion-fixtures": "pnpm validate:v1-source-of-truth",
    "validate:capability-ledger": "pnpm validate:v1-source-of-truth",
    "validate:arch-deps": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/validate-arch-deps.ts",
    "validate:v1-source-of-truth": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/validate-v1-source-of-truth.ts",
    "dump:capability-ledger": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/dump-capability-ledger.ts",
    "validate:ai-fixtures": "pnpm --filter @motionvideo/ai-planner exec tsx ../../scripts/validate-ai-fixtures.ts",
    "eval:zero-template": "pnpm --filter @motionvideo/ai-planner exec tsx ../../scripts/run-zero-template-eval.ts",
    "validate:primitives": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/validate-runtime-primitives.ts",
    "validate:paint-parity": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/validate-paint-parity.ts",
    "test:parity": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/parity-pixi-remotion.ts",
    "test:kimi": "powershell -ExecutionPolicy Bypass -File scripts/test-kimi-k3.ps1",
    "test:kimi:file": "powershell -ExecutionPolicy Bypass -Command \"if (Test-Path .moonshot-api-key) { $env:MOONSHOT_API_KEY = (Get-Content .moonshot-api-key -Raw).Trim() }; powershell -ExecutionPolicy Bypass -File scripts/test-kimi-k3.ps1\"",
    "bench:motion-runtime": "pnpm --filter @motionvideo/render-worker benchmark",
    "bench:motion-runtime:4k": "pnpm --filter @motionvideo/render-worker exec tsx src/benchmark.ts --scale=2",
    "score:designer-corrections": "pnpm --filter @motionvideo/render-worker exec tsx ../../scripts/score-designer-corrections.ts",
    "storybook": "pnpm --filter @motionvideo/web storybook",
    "storybook:desktop": "pnpm --filter @motionvideo/desktop storybook"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "enhanced-resolve": "5.24.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "esbuild": "0.28.1",
    "eslint": "^9.22.0",
    "picomatch": "^4.0.5",
    "typescript-eslint": "^8.26.1"
  }
}
