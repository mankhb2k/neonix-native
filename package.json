{
  "name": "motionvideo",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "lint": "pnpm -r --if-present lint",
    "dev": "pnpm --filter @motionvideo/web dev",
    "build": "pnpm --filter @motionvideo/web build",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:protocol && pnpm typecheck:html && pnpm typecheck:compiler && pnpm typecheck:runtime && pnpm typecheck:preview && pnpm typecheck:skia && pnpm typecheck:export",
    "typecheck:v2": "pnpm typecheck:editor",
    "typecheck:app": "pnpm --filter @motionvideo/web typecheck",
    "typecheck:editor": "pnpm --filter @motionvideo/web typecheck:editor && pnpm typecheck:protocol && pnpm typecheck:compiler && pnpm typecheck:runtime && pnpm typecheck:preview && pnpm typecheck:skia && pnpm typecheck:export",
    "typecheck:protocol": "pnpm --filter @motionvideo/motion-protocol typecheck",
    "typecheck:html": "pnpm --filter @motionvideo/html-compiler typecheck",
    "typecheck:compiler": "pnpm --filter @motionvideo/motion-compiler typecheck",
    "typecheck:runtime": "pnpm --filter @motionvideo/motion-runtime typecheck",
    "typecheck:preview": "pnpm --filter @motionvideo/preview-renderer typecheck",
    "typecheck:skia": "pnpm --filter @motionvideo/skia-renderer typecheck",
    "typecheck:export": "pnpm --filter @motionvideo/export-renderer typecheck",
    "test": "pnpm test:app && pnpm test:protocol && pnpm test:html && pnpm test:compiler && pnpm test:runtime && pnpm test:preview && pnpm test:skia && pnpm test:export",
    "test:app": "pnpm --filter @motionvideo/web test:editor",
    "test:protocol": "pnpm --filter @motionvideo/motion-protocol test",
    "test:html": "pnpm --filter @motionvideo/html-compiler test",
    "test:compiler": "pnpm --filter @motionvideo/motion-compiler test",
    "test:runtime": "pnpm --filter @motionvideo/motion-runtime test",
    "test:preview": "pnpm --filter @motionvideo/preview-renderer test",
    "test:skia": "pnpm --filter @motionvideo/skia-renderer test",
    "test:export": "pnpm --filter @motionvideo/export-renderer test",
    "certify:playback": "pnpm --filter @motionvideo/playback-engine certify",
    "validate:v2-boundary": "node scripts/validate-v2-boundary.mjs",
    "validate:v2-consumers": "node scripts/validate-v2-consumers.mjs"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "enhanced-resolve": "5.24.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "esbuild": "0.28.1",
    "eslint": "^9.22.0",
    "picomatch": "^4.0.5",
    "typescript-eslint": "^8.26.1"
  }
}
