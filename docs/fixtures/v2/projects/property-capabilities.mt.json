{
  "format": "motion-project",
  "formatVersion": 2,
  "metadata": {
    "id": "fixture.property-capabilities",
    "name": "Property capability evaluator",
    "aspectRatio": "1:1",
    "fps": 30,
    "locale": "vi-VN",
    "brand": { "name": "Fixture", "primaryColor": "#111111" }
  },
  "dependencies": { "components": [] },
  "assets": [],
  "variables": [],
  "timeline": { "sceneOrder": ["scene.properties"], "audioTracks": [] },
  "scenes": [
    {
      "id": "scene.properties",
      "duration": 2,
      "nodes": [
        {
          "id": "text.animated",
          "type": "text",
          "parentId": null,
          "transform": { "x": 540, "y": 540, "width": 800, "height": 160, "rotation": 0, "scaleX": 1, "scaleY": 1, "anchorX": 0.5, "anchorY": 0.5, "opacity": 1, "visible": true, "flipX": false, "flipY": false },
          "payload": { "text": "A", "fontSize": 40, "align": "center" },
          "style": { "fill": "#ff0000" }
        }
      ],
      "clips": [
        {
          "id": "text-properties",
          "schedule": { "kind": "absolute", "at": 0 },
          "duration": 1,
          "source": {
            "kind": "tracks",
            "tracks": [
              { "targetId": "text.animated", "property": "payload.text", "keys": [{ "t": 0, "v": "A" }, { "t": 1, "v": "B", "easing": "step" }] },
              { "targetId": "text.animated", "property": "payload.fontSize", "keys": [{ "t": 0, "v": 40 }, { "t": 1, "v": 80, "easing": "linear" }] },
              { "targetId": "text.animated", "property": "style.fill", "keys": [{ "t": 0, "v": "#ff0000" }, { "t": 1, "v": "#00ff00", "easing": "step" }] }
            ]
          }
        }
      ]
    }
  ],
  "bindings": [],
  "extensions": { "constraints": [], "events": [] }
}
