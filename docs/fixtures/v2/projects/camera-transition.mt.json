{
  "format": "motion-project",
  "formatVersion": 2,
  "metadata": {
    "id": "proj.camera-transition",
    "name": "Camera Projection and Transition",
    "description": "Camera tracks change the framing before Scene A crossfades into Scene B.",
    "aspectRatio": "1:1",
    "fps": 30,
    "locale": "vi-VN",
    "brand": { "name": "Camera test", "primaryColor": "#0f172a" }
  },
  "dependencies": { "components": [] },
  "assets": [],
  "variables": [],
