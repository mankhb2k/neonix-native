      "name": "Camera movement",
      "duration": 3,
      "activeCameraId": "camera.main",
      "transition": { "type": "crossfade", "duration": 1 },
      "nodes": [
        {
          "id": "camera.main",
          "type": "camera",
          "parentId": null,
          "zIndex": 0,
