          "payload": { "zoom": 1, "projection": "orthographic" }
        },
        {
          "id": "shape.a.background",
          "type": "shape",
          "parentId": null,
          "zIndex": 1,
          "transform": { "x": 540, "y": 540, "width": 1080, "height": 1080, "rotation": 0, "scaleX": 1, "scaleY": 1, "anchorX": 0.5, "anchorY": 0.5, "opacity": 1, "visible": true, "flipX": false, "flipY": false },
          "payload": { "shape": "rectangle" },
          "style": { "fill": "#082f49" }
        },
        {
          "id": "shape.a.red",
          "type": "shape",
          "parentId": null,
          "zIndex": 2,
          "transform": { "x": 250, "y": 300, "width": 260, "height": 260, "rotation": 0, "scaleX": 1, "scaleY": 1, "anchorX": 0.5, "anchorY": 0.5, "opacity": 1, "visible": true, "flipX": false, "flipY": false },
          "payload": { "shape": "rectangle", "cornerRadius": 48 },
          "style": { "fill": "#ef4444" }
        },
        {
          "id": "shape.a.yellow",
          "type": "shape",
          "parentId": null,
          "zIndex": 3,
          "transform": { "x": 780, "y": 430, "width": 300, "height": 300, "rotation": 0, "scaleX": 1, "scaleY": 1, "anchorX": 0.5, "anchorY": 0.5, "opacity": 1, "visible": true, "flipX": false, "flipY": false },
          "payload": { "shape": "ellipse" },
          "style": { "fill": "#facc15" }
        },
        {
          "id": "shape.a.cyan",
          "type": "shape",
          "parentId": null,
          "zIndex": 4,
          "transform": { "x": 620, "y": 820, "width": 460, "height": 140, "rotation": -12, "scaleX": 1, "scaleY": 1, "anchorX": 0.5, "anchorY": 0.5, "opacity": 1, "visible": true, "flipX": false, "flipY": false },
          "payload": { "shape": "rectangle", "cornerRadius": 70 },
          "style": { "fill": "#22d3ee" }
        }
      ],
      "clips": [
        {
          "id": "camera.animate",
          "targetId": "camera.main",
          "schedule": { "kind": "absolute", "at": 0 },
          "duration": 3,
          "playback": { "iterations": 1, "direction": "normal", "rate": 1 },
          "source": {
            "kind": "tracks",
            "tracks": [
              { "targetId": "camera.main", "property": "transform.x", "keys": [{ "t": 0, "v": 540 }, { "t": 3, "v": 700 }] },
              { "targetId": "camera.main", "property": "transform.y", "keys": [{ "t": 0, "v": 540 }, { "t": 3, "v": 450 }] },
              { "targetId": "camera.main", "property": "transform.rotation", "keys": [{ "t": 0, "v": 0 }, { "t": 3, "v": 20 }] },
              { "targetId": "camera.main", "property": "payload.zoom", "keys": [{ "t": 0, "v": 1 }, { "t": 3, "v": 1.45 }] }
            ]
          }
        }
      ]
    },
    {
      "id": "scene.camera-b",
