{
  "format": "motion-project",
  "formatVersion": 2,
  "metadata": {
    "id": "fixture.professional-interpolation",
    "name": "Professional interpolation",
    "aspectRatio": "1:1",
    "fps": 30,
    "locale": "vi-VN",
    "brand": { "name": "Fixture", "primaryColor": "#111111" }
  },
  "dependencies": { "components": [] },
  "assets": [],
  "variables": [],
  "timeline": { "sceneOrder": ["scene.interp"], "audioTracks": [] },
  "scenes": [
    {
      "id": "scene.interp",
      "duration": 2,
      "markers": [{ "id": "hit", "t": 1 }],
      "nodes": [
        {
          "id": "box",
          "type": "shape",
          "parentId": null,
          "transform": {
            "x": 0,
            "y": 100,
            "width": 40,
            "height": 40,
            "rotation": 0,
            "scaleX": 1,
            "scaleY": 1,
            "anchorX": 0.5,
            "anchorY": 0.5,
            "opacity": 1,
            "visible": true,
            "flipX": false,
            "flipY": false
          },
          "payload": { "shape": "rectangle" },
          "style": { "fill": "#22c55e" }
        }
      ],
      "clips": [
        {
          "id": "cubic-x",
          "schedule": { "kind": "absolute", "at": 0 },
          "duration": 2,
          "source": {
            "kind": "tracks",
            "tracks": [
              {
                "targetId": "box",
                "property": "transform.x",
                "keys": [
                  { "t": 0, "v": 0 },
                  {
                    "t": { "markerId": "hit", "offset": 0 },
                    "v": 200,
                    "easing": { "type": "cubic-bezier", "x1": 0.42, "y1": 0, "x2": 0.58, "y2": 1 }
                  },
                  {
                    "t": 2,
                    "v": 100,
                    "easing": { "type": "spring", "stiffness": 180, "damping": 14, "mass": 1 }
                  }
                ]
              },
              {
                "targetId": "box",
                "property": "transform.rotation",
                "valueKind": "angle",
                "keys": [
                  { "t": 0, "v": 350 },
                  { "t": 1, "v": 10, "easing": "linear" }
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "bindings": [],
  "extensions": { "constraints": [], "events": [] }
}
