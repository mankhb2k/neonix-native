{
  "format": "motion-component",
  "formatVersion": 2,
  "componentId": "comp.product-showcase",
  "componentVersion": "1.0.0",
  "metadata": {
    "name": "Product Showcase",
    "nameVi": "Giới thiệu sản phẩm",
    "description": "Image + price + CTA + theme — nền cho Golden Fixture"
  },
  "assets": [
    {
      "id": "asset.product.default",
      "assetType": "image",
      "uri": "assets/demo-product.png"
    }
  ],
  "variables": [
    { "id": "var.productName", "type": "string", "name": "Product Name", "value": "Cà Phê Sáng" },
    { "id": "var.price", "type": "string", "name": "Price", "value": "49K" },
    { "id": "var.cta", "type": "string", "name": "CTA", "value": "Đặt ngay" },
    { "id": "var.theme", "type": "enum", "name": "Theme", "value": "warm", "options": ["warm", "cool", "dark"] },
    { "id": "var.primaryColor", "type": "color", "name": "Primary", "value": "#C45C26" },
    { "id": "var.productImage", "type": "image", "name": "Product Image", "value": "asset.product.default" },
    { "id": "var.animationSpeed", "type": "number", "name": "Speed", "value": 1 }
  ],
  "publicAPI": [
    { "id": "productName", "type": "string", "variableId": "var.productName", "semantic": { "role": "product-name" } },
    { "id": "price", "type": "string", "variableId": "var.price", "semantic": { "role": "price" } },
    { "id": "cta", "type": "string", "variableId": "var.cta", "semantic": { "role": "cta-text" } },
    { "id": "theme", "type": "enum", "variableId": "var.theme", "options": ["warm", "cool", "dark"] },
    { "id": "primaryColor", "type": "color", "variableId": "var.primaryColor", "semantic": { "role": "brand-primary" } },
    { "id": "productImage", "type": "image", "variableId": "var.productImage", "semantic": { "role": "product-image" } },
    { "id": "animationSpeed", "type": "number", "variableId": "var.animationSpeed", "semantic": { "role": "animation-speed" } }
  ],
  "nodes": [
    {
      "id": "root",
      "type": "group",
      "parentId": null,
      "transform": {
        "x": 0, "y": 0, "width": 1080, "height": 1920,
        "rotation": 0, "scaleX": 1, "scaleY": 1,
        "anchorX": 0.5, "anchorY": 0.5, "opacity": 1, "visible": true,
        "flipX": false, "flipY": false
      }
    },
    {
      "id": "product-image",
      "type": "image",
      "parentId": "root",
      "semantic": { "role": "product-image" },
      "zIndex": 1,
      "transform": {
        "x": 140, "y": 360, "width": 800, "height": 800,
        "rotation": 0, "scaleX": 1, "scaleY": 1,
        "anchorX": 0.5, "anchorY": 0.5, "opacity": 1, "visible": true,
        "flipX": false, "flipY": false
      },
      "payload": { "assetId": "asset.product.default", "fit": "cover" }
    },
    {
      "id": "product-name",
      "type": "text",
      "parentId": "root",
      "semantic": { "role": "hero-title" },
      "zIndex": 2,
      "transform": {
        "x": 80, "y": 1220, "width": 920, "height": 72,
        "rotation": 0, "scaleX": 1, "scaleY": 1,
        "anchorX": 0, "anchorY": 0, "opacity": 1, "visible": true,
        "flipX": false, "flipY": false
      },
      "payload": { "text": "Cà Phê Sáng", "fontSize": 48, "align": "center", "fontWeight": 700 }
    },
    {
      "id": "price",
      "type": "text",
      "parentId": "root",
      "semantic": { "role": "price" },
      "zIndex": 2,
      "transform": {
        "x": 80, "y": 1320, "width": 920, "height": 64,
        "rotation": 0, "scaleX": 1, "scaleY": 1,
        "anchorX": 0, "anchorY": 0, "opacity": 1, "visible": true,
        "flipX": false, "flipY": false
      },
      "style": { "fill": "#C45C26" },
      "payload": { "text": "49K", "fontSize": 40, "align": "center", "fontWeight": 700 }
    },
    {
      "id": "cta",
      "type": "group",
      "parentId": "root",
      "semantic": { "role": "cta" },
      "zIndex": 3,
      "transform": {
        "x": 290, "y": 1480, "width": 500, "height": 88,
        "rotation": 0, "scaleX": 1, "scaleY": 1,
        "anchorX": 0.5, "anchorY": 0.5, "opacity": 1, "visible": true,
        "flipX": false, "flipY": false
      }
    },
    {
      "id": "cta-bg",
      "type": "shape",
      "parentId": "cta",
      "semantic": { "role": "cta-background" },
      "transform": {
        "x": 0, "y": 0, "width": 500, "height": 88,
        "rotation": 0, "scaleX": 1, "scaleY": 1,
        "anchorX": 0, "anchorY": 0, "opacity": 1, "visible": true,
        "flipX": false, "flipY": false
      },
      "style": { "fill": "#C45C26", "cornerRadius": 16 },
      "payload": { "shape": "rectangle" }
    },
    {
      "id": "cta-label",
      "type": "text",
      "parentId": "cta",
      "semantic": { "role": "cta-label" },
      "transform": {
        "x": 0, "y": 20, "width": 500, "height": 48,
        "rotation": 0, "scaleX": 1, "scaleY": 1,
        "anchorX": 0, "anchorY": 0, "opacity": 1, "visible": true,
        "flipX": false, "flipY": false
      },
      "style": { "fill": "#FFFFFF" },
      "payload": { "text": "Đặt ngay", "fontSize": 28, "align": "center", "fontWeight": 600 }
    }
  ],
  "bindings": [
    { "id": "b.name", "source": { "kind": "variable", "variableId": "var.productName" }, "target": { "nodeId": "product-name", "property": "payload.text" } },
    { "id": "b.price", "source": { "kind": "variable", "variableId": "var.price" }, "target": { "nodeId": "price", "property": "payload.text" } },
    { "id": "b.cta", "source": { "kind": "variable", "variableId": "var.cta" }, "target": { "nodeId": "cta-label", "property": "payload.text" } },
    { "id": "b.priceColor", "source": { "kind": "variable", "variableId": "var.primaryColor" }, "target": { "nodeId": "price", "property": "style.fill" } },
    { "id": "b.ctaBg", "source": { "kind": "variable", "variableId": "var.primaryColor" }, "target": { "nodeId": "cta-bg", "property": "style.fill" } },
    {
      "id": "b.image",
      "source": { "kind": "variable", "variableId": "var.productImage" },
      "target": { "nodeId": "product-image", "property": "payload.assetId" }
    }
  ],
  "clips": [
    {
      "id": "clip.image",
      "targetId": "product-image",
      "schedule": { "kind": "absolute", "at": 0 },
      "duration": 0.7,
      "source": { "kind": "preset", "presetId": "fade-up" }
    },
    {
      "id": "clip.cta",
      "targetId": "cta",
      "schedule": { "kind": "absolute", "at": 0.35 },
      "duration": 0.5,
      "playback": {
        "iterations": 1,
        "direction": "normal",
        "rate": { "ref": { "kind": "variable", "id": "var.animationSpeed" } }
      },
      "source": { "kind": "preset", "presetId": "pop" }
    }
  ]
}
