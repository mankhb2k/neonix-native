{
  "format": "motion-component",
  "formatVersion": 2,
  "componentId": "comp.big-number",
  "componentVersion": "1.0.0",
  "metadata": {
    "name": "Big Number",
    "nameVi": "Số lớn",
    "description": "Highlight một chỉ số lớn + title/subtitle",
    "thumbnail": "assets/image-alpha.png"
  },
  "variables": [
    {
      "id": "var.primaryColor",
      "type": "color",
      "name": "Primary Color",
      "value": "#0F766E"
    },
    {
      "id": "var.title",
      "type": "string",
      "name": "Title",
      "value": "Tăng trưởng"
    },
    {
      "id": "var.number",
      "type": "string",
      "name": "Number",
      "value": "80%"
    },
    {
      "id": "var.subtitle",
      "type": "string",
      "name": "Subtitle",
      "value": "so với tháng trước"
    },
    {
      "id": "var.animationSpeed",
      "type": "number",
      "name": "Animation Speed",
      "value": 1,
      "min": 0.5,
      "max": 2
    }
  ],
  "publicAPI": [
    {
      "id": "title",
      "type": "string",
      "label": "Tiêu đề",
      "variableId": "var.title",
      "semantic": { "role": "hero-title" }
    },
    {
      "id": "number",
      "type": "string",
      "label": "Số lớn",
      "variableId": "var.number",
      "semantic": { "role": "statistic" }
    },
    {
      "id": "subtitle",
      "type": "string",
      "label": "Phụ đề",
      "variableId": "var.subtitle",
      "semantic": { "role": "subtitle" }
    },
    {
      "id": "primaryColor",
      "type": "color",
      "label": "Màu chính",
      "variableId": "var.primaryColor",
      "semantic": { "role": "brand-primary" }
    },
    {
      "id": "animationSpeed",
      "type": "number",
      "label": "Tốc độ animation",
      "variableId": "var.animationSpeed",
      "semantic": { "role": "animation-speed" },
      "min": 0.5,
      "max": 2
    }
  ],
  "nodes": [
    {
      "id": "root",
      "type": "group",
      "name": "Big Number Root",
      "parentId": null,
      "transform": {
        "x": 0,
        "y": 0,
        "width": 1080,
        "height": 1920,
        "rotation": 0,
        "scaleX": 1,
        "scaleY": 1,
        "anchorX": 0.5,
        "anchorY": 0.5,
        "opacity": 1,
        "visible": true,
        "flipX": false,
        "flipY": false
      }
    },
    {
      "id": "bg",
      "type": "shape",
      "name": "Background",
      "parentId": "root",
      "semantic": { "role": "background" },
      "zIndex": 0,
      "transform": {
        "x": 0,
        "y": 0,
        "width": 1080,
        "height": 1920,
        "rotation": 0,
        "scaleX": 1,
        "scaleY": 1,
        "anchorX": 0,
        "anchorY": 0,
        "opacity": 1,
        "visible": true,
        "flipX": false,
        "flipY": false
      },
      "style": { "fill": "#0B1220" },
      "payload": { "shape": "rectangle" }
    },
    {
      "id": "title",
      "type": "text",
      "name": "Title",
      "parentId": "root",
      "semantic": { "role": "hero-title" },
      "zIndex": 2,
      "transform": {
        "x": 80,
        "y": 520,
        "width": 920,
        "height": 80,
        "rotation": 0,
        "scaleX": 1,
        "scaleY": 1,
        "anchorX": 0,
        "anchorY": 0,
        "opacity": 1,
        "visible": true,
        "flipX": false,
        "flipY": false
      },
      "payload": {
        "text": "Tăng trưởng",
        "fontSize": 42,
        "align": "center"
      }
    },
    {
      "id": "number",
      "type": "text",
      "name": "Number",
      "parentId": "root",
      "semantic": { "role": "statistic" },
      "zIndex": 3,
      "transform": {
        "x": 80,
        "y": 640,
        "width": 920,
        "height": 220,
        "rotation": 0,
        "scaleX": 1,
        "scaleY": 1,
        "anchorX": 0.5,
        "anchorY": 0.5,
        "opacity": 1,
        "visible": true,
        "flipX": false,
        "flipY": false
      },
      "style": { "fill": "#0F766E" },
      "payload": {
        "text": "80%",
        "fontSize": 160,
        "align": "center",
        "fontWeight": 700
      }
    },
    {
      "id": "subtitle",
      "type": "text",
      "name": "Subtitle",
      "parentId": "root",
      "semantic": { "role": "subtitle" },
      "zIndex": 2,
      "transform": {
        "x": 80,
        "y": 900,
        "width": 920,
        "height": 60,
        "rotation": 0,
        "scaleX": 1,
        "scaleY": 1,
        "anchorX": 0,
        "anchorY": 0,
        "opacity": 1,
        "visible": true,
        "flipX": false,
        "flipY": false
      },
      "payload": {
        "text": "so với tháng trước",
        "fontSize": 28,
        "align": "center"
      }
    }
  ],
  "bindings": [
    {
      "id": "bind.title",
      "source": { "kind": "variable", "variableId": "var.title" },
      "target": { "nodeId": "title", "property": "payload.text" }
    },
    {
      "id": "bind.number",
      "source": { "kind": "variable", "variableId": "var.number" },
      "target": { "nodeId": "number", "property": "payload.text" }
    },
    {
      "id": "bind.subtitle",
      "source": { "kind": "variable", "variableId": "var.subtitle" },
      "target": { "nodeId": "subtitle", "property": "payload.text" }
    },
    {
      "id": "bind.numberColor",
      "source": { "kind": "variable", "variableId": "var.primaryColor" },
      "target": { "nodeId": "number", "property": "style.fill" }
    }
  ],
  "clips": [
    {
      "id": "clip.number-pop",
      "targetId": "number",
      "schedule": { "kind": "absolute", "at": 0 },
      "duration": 0.8,
      "playback": {
        "iterations": 1,
        "direction": "normal",
        "rate": { "ref": { "kind": "variable", "id": "var.animationSpeed" } }
      },
      "source": {
        "kind": "preset",
        "presetId": "pop"
      }
    },
    {
      "id": "clip.title-fade",
      "targetId": "title",
      "schedule": { "kind": "absolute", "at": 0.1 },
      "duration": 0.5,
      "source": {
        "kind": "preset",
        "presetId": "fade-up"
      }
    }
  ]
}
