{
  "format": "motion-component", "formatVersion": 2,
  "componentId": "comp.repeater-layouts", "componentVersion": "1.0.0",
  "metadata": { "name": "Repeater vNext layouts" },
  "assets": [],
  "variables": [{
    "id": "var.items", "type": "list", "name": "Stable list items",
    "itemSchema": { "type": "object", "fields": { "id": { "type": "string" }, "color": { "type": "color" } } },
    "value": [{ "id": "alpha", "color": "#ef4444" }, { "id": "beta", "color": "#f97316" }, { "id": "gamma", "color": "#facc15" }]
  }],
  "publicAPI": [],
  "nodes": [
    {
      "id": "root", "type": "group", "parentId": null,
      "transform": { "x": 0, "y": 0, "width": 1080, "height": 1080, "rotation": 0, "scaleX": 1, "scaleY": 1, "anchorX": 0, "anchorY": 0, "opacity": 1, "visible": true, "flipX": false, "flipY": false }
    },
    {
      "id": "list-item", "type": "shape", "parentId": "root",
      "repeat": { "source": { "kind": "list", "variableId": "var.items", "keyPath": "id" }, "itemAlias": "item", "indexAlias": "index", "layout": { "kind": "linear", "offsetX": 90, "offsetY": 0 }, "timeStagger": 0.05 },
      "transform": { "x": 90, "y": 100, "width": 64, "height": 64, "rotation": 0, "scaleX": 1, "scaleY": 1, "anchorX": 0.5, "anchorY": 0.5, "opacity": 1, "visible": true, "flipX": false, "flipY": false },
      "payload": { "shape": "ellipse" }, "style": { "fill": "#ef4444" }
    },
    {
      "id": "grid-item", "type": "shape", "parentId": "root",
      "repeat": { "source": { "kind": "count", "count": 6, "keyPrefix": "cell" }, "layout": { "kind": "grid", "columns": 3, "gapX": 110, "gapY": 100 }, "timeStagger": 0.1 },
      "transform": { "x": 110, "y": 300, "width": 72, "height": 72, "rotation": 0, "scaleX": 1, "scaleY": 1, "anchorX": 0.5, "anchorY": 0.5, "opacity": 1, "visible": true, "flipX": false, "flipY": false },
      "payload": { "shape": "rectangle", "cornerRadius": 12 }, "style": { "fill": "#14b8a6" }
    },
    {
      "id": "radial-item", "type": "shape", "parentId": "root",
      "repeat": { "source": { "kind": "count", "count": 5, "keyPrefix": "ray" }, "layout": { "kind": "radial", "radius": 170, "startAngle": 0, "endAngle": 288, "orientToAngle": true }, "timeStagger": 0.04 },
      "transform": { "x": 700, "y": 380, "width": 36, "height": 100, "rotation": 0, "scaleX": 1, "scaleY": 1, "anchorX": 0.5, "anchorY": 0.5, "opacity": 1, "visible": true, "flipX": false, "flipY": false },
      "payload": { "shape": "rectangle", "cornerRadius": 18 }, "style": { "fill": "#a855f7" }
    },
    {
      "id": "none-item", "type": "shape", "parentId": "root",
      "repeat": { "source": { "kind": "count", "count": 2, "keyPrefix": "overlay" }, "layout": { "kind": "none" }, "timeStagger": 0 },
      "transform": { "x": 220, "y": 650, "width": 180, "height": 90, "rotation": 0, "scaleX": 1, "scaleY": 1, "anchorX": 0.5, "anchorY": 0.5, "opacity": 0.5, "visible": true, "flipX": false, "flipY": false },
      "payload": { "shape": "rectangle", "cornerRadius": 45 }, "style": { "fill": "#3b82f6" }
    }
  ],
  "bindings": [{ "id": "bind.list-color", "source": { "kind": "context", "path": "item.color" }, "target": { "nodeId": "list-item", "property": "style.fill" } }],
  "clips": [{ "id": "grid-stagger", "targetId": "grid-item", "schedule": { "kind": "absolute", "at": 0 }, "duration": 0.4, "source": { "kind": "preset", "presetId": "fade-in" } }]
}
