# Marketing site (motionvideo.com)
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000

# Product app:
# - local:  http://localhost:3000/app
# - prod:   https://app.motionvideo.com
NEXT_PUBLIC_APP_URL=http://localhost:3000/app

DATABASE_URL=

# Queue / worker
REDIS_URL=redis://localhost:6379

# Storage
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# AI — stub (default) | live | anthropic (requires ANTHROPIC_API_KEY)
AI_MODE=stub
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Stage preview: remotion (default) | dom | pixi
# dom/pixi use PreviewStageHost + StageRendererPort (desktop-style; pixi→dom until P1)
NEXT_PUBLIC_STAGE_RENDERER=remotion

# Export: set to 1 for mock jobs in Playwright; omit for real /api/export/jobs
# NEXT_PUBLIC_EXPORT_MOCK=1

# Render-worker paint path (shared PaintCommandBuffer → canvas). Default = legacy draw.ts
# MOTIONVIDEO_PAINT_PATH=1
