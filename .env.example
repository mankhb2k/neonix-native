# Copy this file to .env.local for local development.
# Never commit .env.local or put server-only secrets in NEXT_PUBLIC_* variables.

# -----------------------------------------------------------------------------
# App URLs (public)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000/app

# -----------------------------------------------------------------------------
# Supabase Auth + Postgres
# -----------------------------------------------------------------------------
# Public values: safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_key>

# Server-only. Required for trusted webhooks/admin jobs; never send to Claude.
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# Used by the MCP server when validating OAuth tokens.
SUPABASE_OAUTH_ISSUER=https://<project-ref>.supabase.co/auth/v1
MCP_SERVER_URL=http://localhost:3000/api/mcp
# Resource identifier advertised to MCP clients. This is not the Supabase JWT audience;
# Supabase access tokens use the `authenticated` audience and are verified via JWKS.
MCP_TOKEN_AUDIENCE=http://localhost:3000/api/mcp
MCP_AUDIT_SALT=<random-32-plus-byte-secret>

# Google OAuth Web client created in Google Cloud project "Neonix".
# For a hosted Supabase project, enter these two values in:
# Authentication -> Providers -> Google. Keep both values server-side.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<numeric-id>.apps.googleusercontent.com
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
#
# These variables are only read from the environment when running Supabase
# locally with a config.toml. They are not consumed by the browser app.

# Optional direct Postgres connection for migrations/admin scripts.
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# R2 object storage (server-only; enable when MOTION_STORAGE_PROVIDER=r2)
# -----------------------------------------------------------------------------
MOTION_STORAGE_PROVIDER=memory
MOTION_STORAGE_PUBLIC_URL=http://127.0.0.1:8787
# MOTION_STORAGE_API_TOKEN=<local-storage-api-token>

# Required for R2 provider. Use R2_BUCKET (the current package contract).
# R2_ACCOUNT_ID=<cloudflare-account-id>
# R2_ACCESS_KEY_ID=<r2-access-key>
# R2_SECRET_ACCESS_KEY=<r2-secret>
# R2_BUCKET=moticlip-assets-dev
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# -----------------------------------------------------------------------------
# Remotion Lambda export (server-only; optional in local stub mode)
# -----------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=<iam-access-key>
# AWS_SECRET_ACCESS_KEY=<iam-secret>
# AWS_REGION=us-east-1
# REMOTION_FUNCTION_NAME=<remotion-lambda-function-name>
# REMOTION_SERVE_URL=<versioned-remotion-serve-url>
# REMOTION_WEBHOOK_SECRET=<random-32-plus-byte-secret>
# MOTICLIP_EXPORT_PRODUCTION_GATE=1

# -----------------------------------------------------------------------------
# Existing local/dev switches
# -----------------------------------------------------------------------------
# Neonix does not call an AI provider directly. Claude connects through Remote MCP.

# Export mock for Playwright/local tests.
# NEXT_PUBLIC_EXPORT_MOCK=1

# Local render job persistence directory.
# MOTIONVIDEO_RENDER_JOBS_DIR=.tmp/render-jobs

# Playwright overrides.
# PLAYWRIGHT_PORT=3000
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
